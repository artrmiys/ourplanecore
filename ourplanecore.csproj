<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OurPlaneCore</RootNamespace>
    <AssemblyTitle>ourplanecore</AssemblyTitle>
    <Product>ourplanecore</Product>
    <AssemblyName>ourplanecore</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF rendering via PDFium (Google Chrome engine) -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />

    <!-- GPU-accelerated 2D drawing overlay -->
    <PackageReference Include="SkiaSharp"                       Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.WPF"            Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Tools\pdf_layers_helper.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*" />
  </ItemGroup>

</Project>

