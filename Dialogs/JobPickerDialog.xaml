<Window x:Class="OurPlaneCore.Controls.JobPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OurPlaneCore.Controls"
        Title="Open Job"
        Width="780" Height="540"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <local:GroupNameToIsExpandedConverter x:Key="GroupNameToIsExpanded"/>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- ═══ Source bar ═══════════════════════════════════════════════ -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel LastChildFill="False">
                <WrapPanel x:Name="SourceChipsPanel" DockPanel.Dock="Left"
                           Orientation="Horizontal"/>
                <Button x:Name="AddFolderButton" DockPanel.Dock="Right"
                        Content="+ Add folder"
                        Style="{StaticResource TopCommandButton}"
                        MinWidth="92" Padding="10,2"
                        Click="AddFolderButton_Click"
                        ToolTip="Add a folder containing OurPlaneCore jobs"/>
            </DockPanel>
            <Border Style="{StaticResource RibbonGroupCap}" Margin="0,4,0,0">
                <TextBlock Text="SOURCES" Style="{StaticResource RibbonGroupLabel}"/>
            </Border>
        </StackPanel>

        <!-- ═══ Search ═══════════════════════════════════════════════════ -->
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
                 Height="26" FontSize="11"
                 Margin="0,12,0,8"
                 Padding="6,4"
                 VerticalContentAlignment="Center"
                 ToolTip="Filter jobs by name or path. Up/Down navigates the list."/>

        <!-- ═══ Footer ═══════════════════════════════════════════════════ -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SampleLink" Text="Sample"
                           Cursor="Hand" FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextDecorations="Underline"
                           MouseLeftButtonUp="SampleLink_Click"
                           ToolTip="Create a guided sample project in the configured Jobs folder"/>
                <TextBlock Text=" · " Margin="6,0" FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock x:Name="ManageLink" Text="Manage folders…"
                           Cursor="Hand" FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextDecorations="Underline"
                           MouseLeftButtonUp="ManageLink_Click"
                           ToolTip="Pick a folder of OurPlaneCore jobs to browse"/>
                <Button x:Name="RemoveFolderButton" Content="Remove folder"
                        Style="{StaticResource TopCommandButton}"
                        MinWidth="94" Padding="10,2" Height="24"
                        Margin="10,0,0,0"
                        Click="RemoveFolderButton_Click"
                        ToolTip="Remove the selected source folder from this list. Files stay on disk."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenButton" Content="Open"
                        Style="{StaticResource TopCommandButton}"
                        MinWidth="80" Padding="14,2" Height="26"
                        IsDefault="True" Click="OpenButton_Click"/>
                <Button x:Name="NewJobButton" Content="PDF job"
                        Style="{StaticResource TopCommandButton}"
                        MinWidth="80" Padding="14,2" Height="26"
                        ToolTip="Create a new job from a folder of PDFs"
                        Click="NewJobButton_Click"/>
                <Button x:Name="BlankJobButton" Content="Blank job"
                        Style="{StaticResource TopCommandButton}"
                        MinWidth="86" Padding="14,2" Height="26"
                        ToolTip="Create an empty job without selecting PDFs"
                        Click="BlankJobButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource TopCommandButton}"
                        MinWidth="80" Padding="14,2" Height="26"
                        IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══ Details strip (bottom of list area) ══════════════════════ -->
        <TextBlock x:Name="DetailsText" DockPanel.Dock="Bottom"
                   FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Margin="2,8,2,0"/>

        <!-- ═══ Job list ═════════════════════════════════════════════════ -->
        <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBackgroundBrush}">
            <ListBox x:Name="JobsList"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="JobsList_MouseDoubleClick"
                     SelectionChanged="JobsList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="{Binding Name, Converter={StaticResource GroupNameToIsExpanded}, Mode=OneTime}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="0">
                                                <Expander.Header>
                                                    <DockPanel LastChildFill="False" Width="700">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ControlForegroundBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border DockPanel.Dock="Right" Height="1"
                                                                Background="{DynamicResource ControlBorderBrush}"
                                                                Margin="8,0,2,0"
                                                                VerticalAlignment="Center"
                                                                Width="400"
                                                                Opacity="0.6"/>
                                                    </DockPanel>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="0,2,0,6"/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:JobPickerItem}">
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumb -->
                            <Border Grid.Column="0"
                                    Width="80" Height="54"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Image Source="{Binding ThumbnailImage}"
                                       Stretch="Uniform" Margin="2"/>
                            </Border>

                            <!-- Name + path -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Margin="10,0,8,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ControlForegroundBrush}"/>
                                <TextBlock Text="{Binding Path}"
                                           FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Date -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding RelativeDate}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <!-- Source label -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SourceLabel}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <!-- Pin glyph (right, hover-only when not pinned) -->
                            <Button Grid.Column="4"
                                    x:Name="StarButton"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Width="22" Height="22"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Pin / unpin this job"
                                    Click="StarButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path x:Name="PinGlyph"
                                      Width="14"
                                      Height="14"
                                      Data="{StaticResource IconSparkle}"
                                      Stretch="Uniform"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke"
                                                    Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Stroke"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
