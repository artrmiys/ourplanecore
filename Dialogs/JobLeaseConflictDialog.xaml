<Window x:Class="OurPlanCore.Controls.JobLeaseConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Is Already Open"
        Width="720"
        MinWidth="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="LeaseWarningBackgroundBrush" Color="#2A2119"/>
        <SolidColorBrush x:Key="LeaseWarningBorderBrush" Color="#8A6236"/>
        <SolidColorBrush x:Key="LeaseWarningForegroundBrush" Color="#F1C27B"/>
        <SolidColorBrush x:Key="LeaseDangerBackgroundBrush" Color="#8F2D2D"/>
        <SolidColorBrush x:Key="LeaseDangerHoverBrush" Color="#A83B3B"/>
        <SolidColorBrush x:Key="LeaseDangerPressedBrush" Color="#742323"/>
        <SolidColorBrush x:Key="LeaseDangerBorderBrush" Color="#D65D5D"/>

        <Style x:Key="LeaseActionButton" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="LeasePrimaryButton" TargetType="Button" BasedOn="{StaticResource LeaseActionButton}">
            <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
        </Style>

        <Style x:Key="LeaseDangerButton" TargetType="Button" BasedOn="{StaticResource LeaseActionButton}">
            <Setter Property="Background" Value="{StaticResource LeaseDangerBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LeaseDangerBorderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LeaseDangerHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource LeaseDangerPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeaseLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="LeaseValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Background="{StaticResource LeaseWarningBackgroundBrush}"
                    BorderBrush="{StaticResource LeaseWarningBorderBrush}"
                    BorderThickness="1">
                <TextBlock Text="!"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource LeaseWarningForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="This job is owned by another OurPlanCore instance"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Choose a safe way to continue."
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <Border x:Name="LeaseStateBadge"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="8,3"
                    CornerRadius="3"
                    Background="{StaticResource LeaseWarningBackgroundBrush}"
                    BorderBrush="{StaticResource LeaseWarningBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock x:Name="LeaseStateText"
                           Text="ACTIVE LEASE"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource LeaseWarningForegroundBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="10,8"
                Background="{StaticResource LeaseWarningBackgroundBrush}"
                BorderBrush="{StaticResource LeaseWarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock FontSize="11"
                       Foreground="{StaticResource LeaseWarningForegroundBrush}"
                       TextWrapping="Wrap">
                Another instance may still be writing pages, takeoffs, scale, and job metadata.
                Concurrent writes can damage the job. Read-only is the safest option when the owner is active.
            </TextBlock>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,12"
                Padding="10,7"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Job" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="JobPathText" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                           Style="{StaticResource LeaseValue}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="OwnerText" Grid.Row="1" Grid.Column="1" Style="{StaticResource LeaseValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Machine" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="MachineText" Grid.Row="1" Grid.Column="3" Style="{StaticResource LeaseValue}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Process" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="ProcessText" Grid.Row="2" Grid.Column="1" Style="{StaticResource LeaseValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Started" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="ProcessStartedText" Grid.Row="2" Grid.Column="3" Style="{StaticResource LeaseValue}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Heartbeat" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="HeartbeatText" Grid.Row="3" Grid.Column="1" Style="{StaticResource LeaseValue}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Version" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="3" Style="{StaticResource LeaseValue}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Instance ID" Style="{StaticResource LeaseLabel}"/>
                <TextBlock x:Name="InstanceIdText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                           Style="{StaticResource LeaseValue}" FontFamily="Consolas" FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="TakeOverHintText"
                       DockPanel.Dock="Left"
                       MaxWidth="205"
                       Text="Take Over replaces the existing lease."
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open Read-Only"
                        Style="{StaticResource LeasePrimaryButton}"
                        Click="OpenReadOnlyButton_Click"
                        ToolTip="Open without saving or modifying this job"/>
                <Button Content="Retry"
                        Style="{StaticResource LeaseActionButton}"
                        IsDefault="True"
                        Click="RetryButton_Click"
                        ToolTip="Check the lease again"/>
                <Button x:Name="TakeOverButton"
                        Content="Take Over"
                        Style="{StaticResource LeaseDangerButton}"
                        Click="TakeOverButton_Click"
                        ToolTip="Replace the current lease after an additional confirmation"/>
                <Button Content="Cancel"
                        Style="{StaticResource LeaseActionButton}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
