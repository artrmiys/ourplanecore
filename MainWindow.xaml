                        <Button Content="Generate Roof" Click="Btn3dBuildRoof_Click" Style="{StaticResource ManagerPrimaryButton}" ToolTip="Generate roof mesh from Eave edges and pitch"/>
                        <Button Content="Clear Roof" Click="Btn3dClearRoof_Click" ToolTip="Clear roof base, edge roles, and generated mesh"/>
                        <TextBlock Text="Viewer" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Fit" Click="Btn3dViewerFit_Click" ToolTip="Fit the clean 3D viewer scene"/>
                        <Button Content="Iso" Click="Btn3dViewerIso_Click" ToolTip="Show isometric view"/>
                        <Button Content="Top" Click="Btn3dViewerTop_Click" ToolTip="Show top view"/>
                        <Button Content="Front" Click="Btn3dViewerFront_Click" ToolTip="Show front view"/>
                        <Button Content="Reset" Click="Btn3dViewerReset_Click" Margin="0,0,12,4" ToolTip="Reset the 3D camera view"/>
                    </WrapPanel>
                    </Border>
                    <Grid Background="Transparent"
                          MouseLeftButtonDown="ThreeDViewerViewport_MouseLeftButtonDown"
                          MouseLeftButtonUp="ThreeDViewerViewport_MouseLeftButtonUp"
                          MouseRightButtonDown="ThreeDViewerViewport_MouseRightButtonDown"
                          MouseRightButtonUp="ThreeDViewerViewport_MouseRightButtonUp"
                          MouseMove="ThreeDViewerViewport_MouseMove"
                          MouseWheel="ThreeDViewerViewport_MouseWheel">
                        <Viewport3D x:Name="ThreeDViewerViewport"
                                    ClipToBounds="True">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="ThreeDViewerCamera"
                                                   Position="18,14,18"
                                                   LookDirection="-18,-10,-18"
                                                   UpDirection="0,1,0"
                                                   FieldOfView="42"/>
                            </Viewport3D.Camera>
                        </Viewport3D>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Opacity="0.92"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="Txt3dManagerSummary"
                                       Text="3D viewer ready. Select takeoff lines, then use 3D > Wall or the Wall button."
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

    </DockPanel>
    <Grid x:Name="BusyOverlay"
          Panel.ZIndex="1000"
          Visibility="Collapsed"
          Background="#66000000"
          IsHitTestVisible="True">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="240"
                MaxWidth="360"
                Padding="18"
                CornerRadius="4"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse Width="42"
                             Height="42"
                             Stroke="#D1D5DB"
                             StrokeThickness="4"/>
                    <Ellipse Width="42"
                             Height="42"
                             Stroke="#2563EB"
                             StrokeThickness="4"
                             StrokeDashArray="2 4"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="BusySpinnerRotate"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="BusySpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="BusyOverlayText"
                           Text="Working..."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource ControlForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>

