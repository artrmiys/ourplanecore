<Window x:Class="OurPlaneCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ourplanecore" Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        Icon="Assets/ourplanecore.ico"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="TopCommandButton" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <Style x:Key="TopCommandToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template" Value="{StaticResource ToolToggleButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TopCommandCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="TopCommandLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <!-- Ribbon group footer label (canon §8: label below, on a 1px top border) -->
        <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="RibbonRowLabel" TargetType="TextBlock" BasedOn="{StaticResource TopCommandLabel}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="RibbonSlider" TargetType="Slider">
            <Setter Property="Width" Value="94"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
        <Style x:Key="RibbonValue" TargetType="TextBox">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style x:Key="RibbonGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="RibbonGroupSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="Margin" Value="6,3,6,3"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootFrame">
    <DockPanel x:Name="RootDock">

        <TabControl x:Name="TopMainTabs"
                    DockPanel.Dock="Top"
                    ItemContainerStyle="{StaticResource CommandTabItem}"
                    MinHeight="118"
                    MaxHeight="126"
                    FontSize="11"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}">
            <TabItem Header="Main">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                            <TextBlock Text="Job" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Open / Import" Click="BtnOpenImportMenu_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Open jobs, switch job folders, create jobs, or import PDF files"/>
                            <Button Content="PlanSwift" Click="BtnImportPlanSwiftJob_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Separate PlanSwift job converter"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Orientation="Horizontal" Margin="9,0,9,0">
                            <TextBlock Text="PDF" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Export" Click="BtnExportPdf_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Export selected/all sheets to a PDF"/>
                            <Button Content="Name" Click="BtnAutoRenamePdf_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Preview and apply PDF sheet names"/>
                            <Button Content="Scale" Click="BtnAutoScalePdf_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Preview and apply PDF sheet scale"/>
                            <Button Content="Name+Scale" Click="BtnAutoRenameScalePdf_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Preview and apply PDF sheet names and scale"/>
                            <Button Content="AI Fill" Click="BtnQueuePdfMetadataFallback_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Queue GPT fallback for missing PDF sheet metadata"/>
                            <Button Content="Crop Hints" Click="BtnPdfMetadataCropHints_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Draw reusable AI Fill crop boxes for sheet number and scale"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Page">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                            <TextBlock Text="Add" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Add Pages" Click="BtnPageAddPages_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Import PDF pages into the current job"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Orientation="Horizontal" Margin="9,0,9,0">
                            <TextBlock Text="Rename / Sort" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Batch Rename" Click="BtnPageBatchRename_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Rename selected pages in order"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Orientation="Horizontal" Margin="9,0,9,0">
                            <TextBlock Text="Rotate" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Left" Click="BtnPageRotateLeft_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Rotate the active page left"/>
                            <Button Content="Right" Click="BtnPageRotateRight_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Rotate the active page right"/>
                            <Button Content="180" Click="BtnPageRotate180_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Rotate the active page 180 degrees"/>
                            <Button Content="Level" Click="BtnPageLevel_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Reset page view to fit and clear temporary drawing input"/>
                            <Button Content="Batch Rotate" Click="BtnPageBatchRotate_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Rotate selected pages"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Orientation="Horizontal" Margin="9,0,9,0">
                            <TextBlock Text="Flip" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Vertical" Click="BtnPageFlipVertical_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Flip the active page vertically"/>
                            <Button Content="Horizontal" Click="BtnPageFlipHorizontal_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Flip the active page horizontally"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Orientation="Horizontal" Margin="9,0,9,0">
                            <TextBlock Text="Image Tools" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Invert" Click="BtnPageInvert_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Invert the active page colors"/>
                            <Button Content="Crop New Page" Click="BtnPageCropNew_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Create a new page from the currently visible viewport area"/>
                            <Button Content="Copy" Click="BtnPageCopyToClipboard_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Copy a rendered PNG of the active page to the clipboard"/>
                        </StackPanel>
                        <Separator/>
                        <StackPanel Orientation="Horizontal" Margin="9,0,9,0">
                            <TextBlock Text="Other" Style="{StaticResource TopCommandLabel}"/>
                            <Button Content="Set Origin" Click="BtnPageSetOrigin_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Mark the current visible page center as the page origin"/>
                            <Button Content="Offset Origin" Click="BtnPageOffsetOrigin_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Nudge the stored page origin"/>
                            <Button Content="Close Page" Click="BtnPageClose_Click" Style="{StaticResource TopCommandButton}"
                                    ToolTip="Close the active page tab"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Viewport">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,2">

                        <!-- GROUP: LINES & AREA -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Line" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider Grid.Column="1" x:Name="SldLineThickness" Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldLineThickness_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Line measurement thickness 0.25 - 4.0"/>
                                <TextBox Grid.Column="2" x:Name="TxtMeasurementStrokeScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtMeasurementStrokeScale_KeyDown" LostFocus="TxtMeasurementStrokeScale_LostFocus"
                                         ToolTip="Type a line thickness 0.25 - 4.0 and press Enter"/>
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Point" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider Grid.Column="1" x:Name="SldPointSize" Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldPointSize_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Count marker size 0.25 - 4.0"/>
                                <TextBox Grid.Column="2" x:Name="TxtMeasurementPointScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtMeasurementPointScale_KeyDown" LostFocus="TxtMeasurementPointScale_LostFocus"
                                         ToolTip="Type a point size 0.25 - 4.0 and press Enter"/>
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edge" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider Grid.Column="1" x:Name="SldAreaEdge" Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldAreaEdge_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Area boundary thickness 0.25 - 4.0"/>
                                <TextBox Grid.Column="2" x:Name="TxtAreaEdgeScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtAreaEdgeScale_KeyDown" LostFocus="TxtAreaEdgeScale_LostFocus"
                                         ToolTip="Type an area edge thickness 0.25 - 4.0 and press Enter"/>
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fill" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider Grid.Column="1" x:Name="SldAreaFill" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldAreaFill_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Area fill opacity 0 - 100 %"/>
                                <TextBox Grid.Column="2" x:Name="TxtAreaFillOpacity" Text="24" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtAreaFillOpacity_KeyDown" LostFocus="TxtAreaFillOpacity_LostFocus"
                                         ToolTip="Type an area fill opacity 0 - 100 % and press Enter"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="LINES &amp; AREA" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: LABELS -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplayMeasurementLabels" Content="All" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Master toggle for all measurement value labels"/>
                                <CheckBox x:Name="ChkDisplayLineLabels" Content="Line ft" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show length label on each line measurement"/>
                                <CheckBox x:Name="ChkDisplayAreaLabels" Content="Area sf" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show area label on each area measurement"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplayJoistLabels" Content="Joist sf" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show joist segment labels on area joist layouts (separate from the Area sf label)"/>
                                <CheckBox x:Name="ChkDisplayCountLabels" Content="Count ea" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show count label on each count measurement"/>
                            </StackPanel>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Size" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider Grid.Column="1" x:Name="SldLabelScale" Minimum="0.5" Maximum="3" SmallChange="0.25" LargeChange="0.5"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldLabelScale_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Value label size 0.5 - 3.0"/>
                                <TextBox Grid.Column="2" x:Name="TxtMeasurementLabelScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtMeasurementLabelScale_KeyDown" LostFocus="TxtMeasurementLabelScale_LostFocus"
                                         ToolTip="Type a label size 0.5 - 3.0 and press Enter"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplayLabelsScaleWithPage" Content="Scale w/ page" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Off (default): labels keep a fixed screen size when zooming. On: labels grow/shrink with page zoom."/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="LABELS" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: OVERLAYS -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Legend" Style="{StaticResource RibbonRowLabel}"/>
                                <CheckBox x:Name="ChkDisplayLegend" Content="Show" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show or hide the legend overlay on the active sheet"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Content="Size" Click="BtnLegendSizeMenu_Click" Style="{StaticResource TopCommandButton}"
                                        ToolTip="Pick legend size preset"/>
                                <Button Content="Pos" Click="BtnLegendPositionMenu_Click" Style="{StaticResource TopCommandButton}"
                                        ToolTip="Pick legend anchor (corner/edge of the sheet)"/>
                                <CheckBox x:Name="ChkDisplayLegendScaleWithPage" Content="w/ page" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Off (default): legend keeps a fixed screen size when zooming. On: legend grows/shrinks with page zoom."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Header" Style="{StaticResource RibbonRowLabel}"/>
                                <Button Content="Size" Click="BtnScaleHeaderSizeMenu_Click" Style="{StaticResource TopCommandButton}"
                                        ToolTip="Pick header size preset"/>
                                <CheckBox x:Name="ChkDisplayHeaderScaleWithPage" Content="w/ page" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Off (default): header keeps a fixed screen size when zooming. On: header grows/shrinks with page zoom."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplaySimplifyNavigation" Content="Fast pan/zoom" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Simplify overlays while panning or zooming. Faster on heavy sheets, off by default for full visual quality."/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="OVERLAYS" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: UNITS / VIEW -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplayImperial" Content="ft / sf (imperial)" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Imperial units (ft / sf / ea). Off = metric."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Edge" Style="{StaticResource RibbonRowLabel}"/>
                                <ComboBox x:Name="ComboDisplayViewportBackground" Width="100" Height="22" FontSize="11" Margin="0,0,5,0"
                                          SelectionChanged="ComboDisplayViewportBackground_SelectionChanged"
                                          ToolTip="Choose the background around the sheet">
                                    <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="Gray" Tag="#F2F2F2"/>
                                    <ComboBoxItem Content="Dark" Tag="#2B2B2B"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Paper" Style="{StaticResource RibbonRowLabel}"/>
                                <ComboBox x:Name="ComboDisplayPageBackground" Width="100" Height="22" FontSize="11" Margin="0,0,5,0"
                                          SelectionChanged="ComboDisplayPageBackground_SelectionChanged"
                                          ToolTip="Choose a softer page background tint">
                                    <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="Soft gray" Tag="#F2F2F2"/>
                                    <ComboBoxItem Content="Medium gray" Tag="#D8D8D8"/>
                                    <ComboBoxItem Content="Dark gray" Tag="#B8B8B8"/>
                                    <ComboBoxItem Content="Warm" Tag="#FFF8E8"/>
                                    <ComboBoxItem Content="Soft green" Tag="#EFF7ED"/>
                                    <ComboBoxItem Content="Black" Tag="#000000"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <ToggleButton x:Name="BtnDisplayDarkTheme" Content="Dark theme" Checked="BtnDarkTheme_Checked" Unchecked="BtnDarkTheme_Unchecked"
                                              Style="{StaticResource TopCommandToggle}"
                                              ToolTip="Toggle dark/light UI theme"/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="UNITS &amp; VIEW" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusJob" Text="No job"
                           FontWeight="Normal" Margin="0,0,4,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem MinWidth="150">
                <TextBlock x:Name="TxtStatusPage" Text="вЂ”"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus"
                           Text="Ready. Open or create a job to start."/>
            </StatusBarItem>
        </StatusBar>

        <!-- в”Ђв”Ђ Toolbar в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
        <ToolBar x:Name="MainToolBar" DockPanel.Dock="Bottom" Background="{DynamicResource ControlBackgroundBrush}">

            <TextBlock x:Name="TxtJobName" VerticalAlignment="Center"
                       Text="вЂ” no job вЂ”" FontSize="11" Margin="4,0"
                       FontWeight="Normal"/>

            <Separator/>

            <!-- Drawing tools (radio group) -->
            <RadioButton x:Name="BtnPan"    Content="Pan"    Click="BtnTool_Click" Tag="pan"
                         GroupName="DrawingTool" ToolTip="Pan (V)"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnSelect" Content="Select" Click="BtnTool_Click" Tag="select"
                         GroupName="DrawingTool" IsChecked="True"
                         ToolTip="Box select measurements (E). Ctrl+C copy, Ctrl+V paste"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnScale"  Content="Scale"  Click="BtnTool_Click" Tag="scale"
                         GroupName="DrawingTool" ToolTip="Set scale (S)"
                         Style="{StaticResource ToolRadio}"/>
            <Grid Margin="1,0">
                <RadioButton x:Name="BtnRuler" Content="Ruler" Click="BtnTool_Click" Tag="ruler"
                             GroupName="DrawingTool" ToolTip="Place a dimension/ruler markup on the PDF (R)"
                             Style="{StaticResource ToolRadio}"
                             Margin="0"
                             MinWidth="58"
                             Padding="6,3,21,3"/>
                <ToggleButton x:Name="BtnRulerSheetVisibility"
                              Width="14"
                              Height="14"
                              Padding="0"
                              Margin="0,0,4,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Focusable="False"
                              Checked="BtnRulerSheetVisibility_Changed"
                              Unchecked="BtnRulerSheetVisibility_Changed"
                              ToolTip="Hide all ruler markups on this sheet">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Ellipse Stroke="{DynamicResource ControlBorderBrush}"
                                         StrokeThickness="1"
                                         Fill="{DynamicResource ControlBackgroundBrush}"/>
                                <Ellipse x:Name="RulerSheetVisibilityDot"
                                         Width="7"
                                         Height="7"
                                         Fill="#2563EB"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Stroke" TargetName="RulerSheetVisibilityDot" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Visibility" TargetName="RulerSheetVisibilityDot" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
            <Button x:Name="BtnAnnotationMenu"
                    Content="Annotation"
                    Click="BtnAnnotationMenu_Click"
                    ToolTip="Annotation tools, color, and thickness"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="82"
                    Padding="6,2"/>
            <RadioButton x:Name="BtnDrawLine"  Content="Draw"  Click="BtnTool_Click" Tag="drawline"
                         GroupName="DrawingTool" ToolTip="Draw a simple non-takeoff line markup (D)"
                         Style="{StaticResource ToolRadio}" Visibility="Collapsed"/>
            <RadioButton x:Name="BtnDrawArrow"  Content="Arrow"  Click="BtnTool_Click" Tag="drawarrow"
                         GroupName="DrawingTool" ToolTip="Draw a simple non-takeoff arrow markup"
                         Style="{StaticResource ToolRadio}" Visibility="Collapsed"/>
            <RadioButton x:Name="BtnDrawRect"  Content="Box"  Click="BtnTool_Click" Tag="drawrect"
                         GroupName="DrawingTool" ToolTip="Draw a simple non-takeoff box markup (B)"
                         Style="{StaticResource ToolRadio}" Visibility="Collapsed"/>
            <RadioButton x:Name="BtnDrawCloud"  Content="Cloud"  Click="BtnTool_Click" Tag="drawcloud"
                         GroupName="DrawingTool" ToolTip="Draw a cloud annotation"
                         Style="{StaticResource ToolRadio}" Visibility="Collapsed"/>
            <RadioButton x:Name="BtnDrawAreaAnnot"  Content="Area"  Click="BtnTool_Click" Tag="drawarea"
                         GroupName="DrawingTool" ToolTip="Draw a filled color area annotation"
                         Style="{StaticResource ToolRadio}" Visibility="Collapsed"/>
            <RadioButton x:Name="BtnNote"  Content="Note"  Click="BtnTool_Click" Tag="note"
                         GroupName="DrawingTool" ToolTip="Write a text note on the sheet (N)"
                         Style="{StaticResource ToolRadio}" Visibility="Collapsed"/>
            <RadioButton x:Name="BtnPoint"  Content="Count"  Click="BtnTool_Click" Tag="point"
                         GroupName="DrawingTool" ToolTip="Create a new Count item and start recording (P). Use the active target Record button to continue an existing item"
                         Style="{StaticResource ToolRadio}"/>
            <Button x:Name="BtnCountSymbolDefault"
                    Content="O"
                    Click="BtnCountSymbolDefault_Click"
                    ToolTip="Default Count display for newly created Count takeoffs"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="28"
                    Padding="4,2"
                    Visibility="Collapsed"/>
            <RadioButton x:Name="BtnLine"   Content="Line"   Click="BtnTool_Click" Tag="line"
                         GroupName="DrawingTool" ToolTip="Create a new Line item and start recording (L). Use the active target Record button to continue an existing item"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnArea"   Content="Area"   Click="BtnTool_Click" Tag="area"
                         GroupName="DrawingTool" ToolTip="Create a new Area item and start recording (A). Use the active target Record button to continue an existing item"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnJoistArea" Content="J Area" Click="BtnTool_Click" Tag="joistarea"
                         GroupName="DrawingTool" ToolTip="Create a new Joist Area item and start recording (J)"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnAreaCut" Content="Cut" Click="BtnTool_Click" Tag="areacut"
                         GroupName="DrawingTool" ToolTip="Cut a rectangular hole from an Area (X)"
                         Style="{StaticResource ToolRadio}"/>
            <ToggleButton x:Name="BtnSnap" Content="Snap"
                          ToolTip="Snap to existing takeoff points (F3)"
                          Checked="BtnSnap_Checked" Unchecked="BtnSnap_Unchecked"
                          Padding="6,2" MinWidth="48"/>
            <ToggleButton x:Name="BtnPdfSnap" Content="PDF Snap"
                          ToolTip="Snap to PDF vector corners and points (Ctrl+F3)"
                          Checked="BtnPdfSnap_Checked" Unchecked="BtnPdfSnap_Unchecked"
                          Padding="6,2" MinWidth="64"/>
            <ToggleButton x:Name="BtnOrtho" Content="Ortho"
                          ToolTip="Lock Line/Area to 90/45 degrees (F8, Shift temporarily toggles)"
                          Checked="BtnOrtho_Checked" Unchecked="BtnOrtho_Unchecked"
                          Padding="6,2" MinWidth="52"/>
            <ToggleButton x:Name="BtnBoxMode" Content="Box"
                          ToolTip="Draw Line/Area measurements by two opposite box corners (F9)"
                          Checked="BtnBoxMode_Checked" Unchecked="BtnBoxMode_Unchecked"
                          Padding="6,2" MinWidth="44"/>

            <Separator/>

            <!-- Zoom controls -->
            <Button Content="Fit"  Click="BtnFit_Click"    ToolTip="Fit page (F)"
                    Style="{StaticResource ToolBtn}"/>
            <Button Content="+"    Click="BtnZoomIn_Click"  ToolTip="Zoom in (Ctrl++)"
                    MinWidth="28" Style="{StaticResource ToolBtn}"/>
            <Button Content="-"    Click="BtnZoomOut_Click" ToolTip="Zoom out (Ctrl+-)"
                    MinWidth="28" Style="{StaticResource ToolBtn}"/>

            <Separator/>

            <!-- Transform selected measurements / markups -->
            <TextBlock Text="Edit" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="2,0,4,0"/>
            <Button x:Name="BtnMirrorHorizontal" Content="Flip H" Click="BtnMirrorHorizontal_Click"
                    ToolTip="Mirror selected measurements/markups horizontally"
                    Style="{StaticResource ToolBtn}" MinWidth="52"/>
            <Button x:Name="BtnMirrorVertical" Content="Flip V" Click="BtnMirrorVertical_Click"
                    ToolTip="Mirror selected measurements/markups vertically"
                    Style="{StaticResource ToolBtn}" MinWidth="52"/>
            <TextBlock Text="Rot" VerticalAlignment="Center" FontSize="11" Margin="6,0,2,0"/>
            <Slider x:Name="SliderRotateSelection"
                    Width="100"
                    Minimum="-180"
                    Maximum="180"
                    Value="0"
                    TickFrequency="15"
                    ValueChanged="SliderRotateSelection_ValueChanged"
                    ToolTip="Rotate selected geometry around its center"/>
            <Button x:Name="BtnResetRotateSelection" Content="0" Click="BtnResetRotateSelection_Click"
                    ToolTip="Center rotate slider for another relative adjustment"
                    Style="{StaticResource ToolBtn}" MinWidth="24"/>
            <TextBlock Text="Scale" VerticalAlignment="Center" FontSize="11" Margin="6,0,2,0"/>
            <Slider x:Name="SliderScaleSelection"
                    Width="90"
                    Minimum="0.25"
                    Maximum="3"
                    Value="1"
                    TickFrequency="0.25"
                    ValueChanged="SliderScaleSelection_ValueChanged"
                    ToolTip="Scale selected geometry around its center"/>
            <Button x:Name="BtnResetScaleSelection" Content="1x" Click="BtnResetScaleSelection_Click"
                    ToolTip="Center scale slider for another relative adjustment"
                    Style="{StaticResource ToolBtn}" MinWidth="30"/>

            <Separator/>

            <!-- Sheet scale -->
            <Label Content="Scale:" VerticalAlignment="Center" Padding="0"/>
            <TextBox x:Name="TxtScaleRatio" Width="112" VerticalAlignment="Center"
                     Text="100" ToolTip="Scale ratio (1:N) вЂ” press Enter to apply"
                     KeyDown="TxtScaleRatio_KeyDown"/>
            <Button Content="Set" Click="BtnSetScale_Click"
                    ToolTip="Apply scale" Style="{StaticResource ToolBtn}"/>
            <Button Content="в–ѕ Presets" Click="BtnScalePresets_Click"
                    ToolTip="Common scale presets" Style="{StaticResource ToolBtn}"/>
            <TextBlock x:Name="TxtScaleInfo" VerticalAlignment="Center"
                       FontSize="11" Margin="4,0"/>

            <Separator/>
            <Button x:Name="BtnOpenAiSettings" Content="AI Settings"
                    ToolTip="OpenAI key status and model settings"
                    Click="BtnOpenAiSettings_Click"
                    Style="{StaticResource ToolBtn}"/>

            <Separator/>
            <TextBlock x:Name="TxtTool" VerticalAlignment="Center"
                       Text="  Tool: Pan" FontSize="11"/>
        </ToolBar>

        <!-- в”Ђв”Ђ Main area: 3-column content + AI Inbox в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
        <TabControl x:Name="WorkspaceTabs"
                    SelectionChanged="WorkspaceTabs_SelectionChanged"
                    ItemContainerStyle="{StaticResource WorkspaceTabItem}"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}">
            <TabItem Header="1 Main View" Tag="MainView">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="280"/>
                <RowDefinition x:Name="InboxSplitterRow" Height="0"/>
                <RowDefinition x:Name="InboxRow" Height="30" MinHeight="30"/>
            </Grid.RowDefinitions>

            <!-- в”Ђв”Ђ Row 0: 3-column layout в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PagesColumn" Width="200" MinWidth="120"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"   MinWidth="400"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition x:Name="TakeoffsColumn" Width="300" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: Pages -->
                <DockPanel x:Name="PagesPanel" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                           SizeChanged="SidePanel_SizeChanged">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorder}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnCollapsePagesTree"
                                        Content="-"
                                        Click="BtnCollapsePagesTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Collapse all Pages nodes"/>
                                <Button x:Name="BtnExpandPagesTree"
                                        Content="+"
                                        Click="BtnExpandPagesTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Expand all Pages nodes"/>
                            </StackPanel>
                            <TextBlock Text="Pages"
                                       Style="{StaticResource PanelHeader}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="320">
                        <StackPanel Margin="4">
                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <Button x:Name="BtnPagesOpenTabs"
                                        Content="Tabs"
                                        Click="BtnPagesOpenTabs_Click"
                                        Padding="4,3"
                                        Margin="0,0,3,0"
                                        FontSize="11"
                                        ToolTip="Open selected Pages sheets as viewport tabs"/>
                                <Button x:Name="BtnPagesDetach"
                                        Content="Detach"
                                        Click="BtnPagesDetach_Click"
                                        Padding="4,3"
                                        Margin="0,0,3,0"
                                        FontSize="11"
                                        ToolTip="Open selected Pages sheets in detached windows"/>
                                <Grid>
                                    <Button x:Name="BtnPagesTileSecondMonitor"
                                            Content="Tile M2"
                                            Click="BtnPagesTileSecondMonitor_Click"
                                            Padding="4,3,19,3"
                                            FontSize="11"
                                            ToolTip="Open selected Pages sheets in detached windows and tile them on monitor 2"/>
                                    <ToggleButton x:Name="BtnPagesTileSecondMonitorVertical"
                                                  Width="14"
                                                  Height="14"
                                                  Padding="0"
                                                  Margin="0,0,4,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  Checked="BtnPagesTileSecondMonitorVertical_Changed"
                                                  Unchecked="BtnPagesTileSecondMonitorVertical_Changed"
                                                  ToolTip="Vertical Tile M2 layout">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Grid>
                                                    <Ellipse Stroke="{DynamicResource ControlBorderBrush}"
                                                             StrokeThickness="1"
                                                             Fill="{DynamicResource ControlBackgroundBrush}"/>
                                                    <Ellipse x:Name="TileM2VerticalDot"
                                                             Width="7"
                                                             Height="7"
                                                             Fill="#2563EB"
                                                             Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Stroke" TargetName="TileM2VerticalDot" Value="#1D4ED8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Visibility" TargetName="TileM2VerticalDot" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </UniformGrid>

                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,4">
                        <TextBlock Text="Page Setup"
                                   FontWeight="Normal"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>
                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <Button x:Name="BtnSortPagesArchStruct"
                                    Content="Sort A/S"
                                    Click="BtnSortPagesArchStruct_Click"
                                    Padding="4,3"
                                    Margin="0,0,3,0"
                                    FontSize="11"
                                    ToolTip="Move imported A sheets to Arch, S sheets to Struct, and trailing '-' sheets to others"/>
                            <Button x:Name="BtnSortPagesSuffix"
                                    Content="D/Sec/WT"
                                    Click="BtnSortPagesSuffix_Click"
                                    Padding="4,3"
                                    Margin="0,0,3,0"
                                    FontSize="11"
                                    ToolTip="Sort suffix sheets inside the selected Pages folder; if no folder is selected, sort all Pages"/>
                            <Button x:Name="BtnRepairMeasurementPageLinks"
                                    Content="Repair"
                                    Click="BtnRepairMeasurementPageLinks_Click"
                                    Padding="4,3"
                                    FontSize="11"
                                    ToolTip="Reconnect saved measurements to the current page folders"/>
                        </UniformGrid>
                        <Button x:Name="BtnFloatingPageSetup"
                                Content="Name / Scale"
                                Click="BtnFloatingPageSetup_Click"
                                Padding="5,3"
                                Margin="0,0,0,4"
                                FontSize="11"
                                ToolTip="Open floating page setup"/>
                        <ComboBox x:Name="ComboFolderTemplateMode"
                                  SelectionChanged="ComboFolderTemplateMode_SelectionChanged"
                                  FontSize="11"
                                  Margin="0,0,0,4"
                                  ToolTip="Folder template mode for Pages and Takeoffs">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="COM"/>
                            <ComboBoxItem Content="EWP"/>
                        </ComboBox>
                        <UniformGrid Columns="2">
                            <Button x:Name="BtnNewPageFolder"
                                    Content="New Folder"
                                    Click="BtnNewPageFolder_Click"
                                    Padding="5,3"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    ToolTip="Create a page folder under the selected Pages folder"/>
                            <Button x:Name="BtnAutoPageFolders"
                                    Content="Auto Folders"
                                    Click="BtnAutoPageFolders_Click"
                                    Padding="5,3"
                                    FontSize="11"
                                    ToolTip="Create standard PlanSwift page folders under selected Pages folder"/>
                        </UniformGrid>
                    </StackPanel>
                    <TabControl x:Name="PagesSideTabs"
                                AutomationProperties.AutomationId="PagesSideTabs"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                Foreground="{DynamicResource ControlForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Margin="2,0,2,2">
                        <TabItem Header="Pages">
                            <DockPanel>
                                <TextBox x:Name="PagesTreeSearchBox"
                                         DockPanel.Dock="Top"
                                         Height="23"
                                         Margin="4,4,4,2"
                                         FontSize="11"
                                         TextChanged="PagesTreeSearchBox_TextChanged"
                                         ToolTip="Search Pages by sheet name"/>
                                <TreeView x:Name="PagesTree"
                                          AutomationProperties.AutomationId="PagesTree"
                                          SelectedItemChanged="PagesTree_SelectedItemChanged"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          HorizontalAlignment="Stretch"
                                          Margin="2"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="PDF Layers">
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                    <Button x:Name="BtnLayersLoad"
                                            Content="Load"
                                            Click="BtnLayersLoad_Click"
                                            Padding="3,1"
                                            Margin="0,0,4,0"
                                            FontSize="10"
                                            ToolTip="Scan PDF layers for the active page on demand"/>
                                    <Button x:Name="BtnLayersOn"
                                            Content="All On"
                                            Click="BtnLayersOn_Click"
                                            Padding="3,1"
                                            Margin="0,0,4,0"
                                            FontSize="10"/>
                                    <Button x:Name="BtnLayersOff"
                                            Content="All Off"
                                            Click="BtnLayersOff_Click"
                                            Padding="3,1"
                                            FontSize="10"/>
                                    <Button x:Name="BtnLayersClearHi"
                                            Content="Clear Hi"
                                            Click="BtnLayersClearHi_Click"
                                            Padding="3,1"
                                            Margin="4,0,0,0"
                                            FontSize="10"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                    <ToggleButton x:Name="BtnLayerTraceMode"
                                                  Content="Layer Trace"
                                                  Click="BtnLayerTraceMode_Click"
                                                  Padding="3,1"
                                                  Margin="0,0,4,0"
                                                  FontSize="10"/>
                                    <Button x:Name="BtnLayerTraceCycle"
                                            Content="Full"
                                            Click="BtnLayerTraceCycle_Click"
                                            Padding="3,1"
                                            Margin="0,0,4,0"
                                            FontSize="10"/>
                                    <Button x:Name="BtnLayerTraceApply"
                                            Content="Apply"
                                            Click="BtnLayerTraceApply_Click"
                                            Padding="3,1"
                                            FontSize="10"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtLayerTraceStatus"
                                           DockPanel.Dock="Top"
                                           Text="Select a layer for Layer Trace."
                                           FontSize="10"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="LayersPanel" Margin="0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              DragCompleted="SidePanelSplitter_DragCompleted"
                              Background="{DynamicResource SplitterBrush}" ResizeBehavior="PreviousAndNext"/>

                <!-- Centre: page tabs + PDF viewport -->
                <Grid x:Name="ViewportHost" Grid.Column="2" Background="{DynamicResource SurfaceBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TabControl x:Name="PageTabs"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                MinHeight="28"
                                SelectionChanged="PageTabs_SelectionChanged"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                Foreground="{DynamicResource ControlForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"/>
                    <Grid x:Name="ViewportSurfaceHost"
                          Grid.Row="1"
                          Background="#FFFFFF"
                          ClipToBounds="True"/>
                    <Border x:Name="ViewportLayerTraceBar"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,12,0"
                            Padding="4"
                            Background="#EFFFFFFF"
                            BorderBrush="#66000000"
                            BorderThickness="1"
                            CornerRadius="4"
                            Panel.ZIndex="8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnViewportLayerTraceToggle"
                                          Content="Manual"
                                          Click="BtnViewportLayerTraceToggle_Click"
                                          Padding="7,2"
                                          MinWidth="82"
                                          FontSize="11"
                                          ToolTip="Toggle Manual / PDF Layer Trace mode in the viewport"/>
                            <Button x:Name="BtnViewportLayerTraceCycle"
                                    Content="Full"
                                    Click="BtnViewportLayerTraceCycle_Click"
                                    Padding="7,2"
                                    Margin="4,0,0,0"
                                    MinWidth="58"
                                    FontSize="11"
                                    ToolTip="Cycle Layer Trace mode (Tab while Layer Trace is on)"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                              DragCompleted="SidePanelSplitter_DragCompleted"
                              Background="{DynamicResource SplitterBrush}" ResizeBehavior="PreviousAndNext"/>

                <!-- Right panel: Takeoffs -->
                <DockPanel x:Name="TakeoffsPanel" Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}"
                           SizeChanged="SidePanel_SizeChanged">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorder}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnCollapseTakeoffsTree"
                                        Content="-"
                                        Click="BtnCollapseTakeoffsTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Collapse all Takeoffs nodes"/>
                                <Button x:Name="BtnExpandTakeoffsTree"
                                        Content="+"
                                        Click="BtnExpandTakeoffsTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Expand all Takeoffs nodes"/>
                            </StackPanel>
                            <TextBlock Text="Takeoffs"
                                       Style="{StaticResource PanelHeader}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="ActiveTakeoffTargetBar"
                            DockPanel.Dock="Top"
                            Visibility="Visible"
                            Background="{DynamicResource ControlActiveBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnActiveTakeoffRecord"
                                    DockPanel.Dock="Right"
                                    Content="Record"
                                    Click="BtnActiveTakeoffRecord_Click"
                                    Padding="6,2"
                                    Margin="6,0,0,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTip="Start or stop recording into the active takeoff item (Space)"/>
                            <Button x:Name="BtnActiveTakeoffMore"
                                    DockPanel.Dock="Right"
                                    Content="More"
                                    Click="BtnActiveTakeoffMore_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTip="More active target actions"/>
                            <Button x:Name="BtnActiveTakeoffProperties"
                                    DockPanel.Dock="Right"
                                    Content="Props"
                                    Click="BtnActiveTakeoffProperties_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Edit active takeoff item properties"/>
                            <Button x:Name="BtnActiveTakeoffFind"
                                    DockPanel.Dock="Right"
                                    Content="Find"
                                    Click="BtnActiveTakeoffFind_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Show active takeoff item in the tree"/>
                            <Button x:Name="BtnActiveTakeoffSheetNext"
                                    DockPanel.Dock="Right"
                                    Content="Sheet"
                                    Click="BtnActiveTakeoffSheetNext_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Choose a takeoff item measured on this sheet"/>
                            <Button x:Name="BtnActiveTakeoffNext"
                                    DockPanel.Dock="Right"
                                    Content="&gt;"
                                    Click="BtnActiveTakeoffNext_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Switch to next takeoff item"/>
                            <Button x:Name="BtnActiveTakeoffPrevious"
                                    DockPanel.Dock="Right"
                                    Content="&lt;"
                                    Click="BtnActiveTakeoffPrevious_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Switch to previous takeoff item"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ActiveTakeoffTargetGlyphHost"
                                        Width="18" Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtActiveTakeoffTarget"
                                               Text="No active takeoff"
                                               Foreground="{DynamicResource ControlActiveForegroundBrush}"
                                               FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtActiveTakeoffTargetMeta"
                                               Text=""
                                               Foreground="{DynamicResource ControlActiveForegroundBrush}"
                                               Opacity="0.86"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,4">
                        <TextBlock x:Name="TxtTotal" Text="Total: вЂ”"
                                   FontWeight="Normal" FontSize="12" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="New Folder" Click="BtnNewTakeoffFolder_Click"
                                    Padding="5,3" Margin="0,0,4,0"/>
                            <Button x:Name="BtnNewTakeoffItem"
                                    Grid.Column="1"
                                    Content="New Item"
                                    Click="BtnNewItem_Click"
                                    Padding="5,3"
                                    ToolTip="Create a takeoff item (T)"/>
                            <Button x:Name="BtnTakeoffRoofBase"
                                    Grid.Column="2"
                                    Content="Roof Base"
