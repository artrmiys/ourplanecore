                        <Button x:Name="BtnInboxAdd" Content="+ Add"
                                DockPanel.Dock="Right"
                                Click="BtnAddObservation_Click"
                                Style="{StaticResource ToolBtn}"
                                Padding="7,2" Margin="4,3" FontSize="11"
                                VerticalAlignment="Center"/>
