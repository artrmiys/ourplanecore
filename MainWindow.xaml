            <GridSplitter x:Name="InboxSplitter" Grid.Row="1" Height="4"
                          HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- в”Ђв”Ђ Row 2: AI Inbox в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
            <Grid x:Name="InboxPanel" Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Inbox header bar вЂ” same background as toolbar/statusbar, set via ApplyTheme -->
                <Border x:Name="InboxHeaderBorder" Grid.Row="0"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
