                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                            <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="80"/>
                            <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="60"/>
                            <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="95"/>
                            <DataGridTextColumn Header="Conf" Binding="{Binding Confidence}" Width="65"/>
                            <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="220"/>
                            <DataGridTextColumn Header="PDF" Binding="{Binding Pdf}" Width="220"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="AI Manager" Tag="AiManager">
                <DockPanel Margin="8" Style="{StaticResource ManagerSurface}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ManagerToolbarBand}">
                    <WrapPanel Orientation="Horizontal" Style="{StaticResource ManagerToolbar}">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource ManagerButton}"/>
                        </WrapPanel.Resources>
                        <TextBlock Text="Setup" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="AI Settings" Click="BtnOpenAiSettings_Click" Margin="0,0,12,4" ToolTip="Open model and key status settings"/>
                        <Button Content="+ Add" Click="BtnAddObservation_Click" ToolTip="Add a manual AI observation or marker note"/>
                        <TextBlock Text="Review" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Refresh" Click="BtnAiManagerRefresh_Click" ToolTip="Reload the AI manager table"/>
                        <Button Content="Open Details" Click="BtnAiManagerOpenDetails_Click" ToolTip="Open details for the selected AI item"/>
                        <Button Content="Go to Page" Click="BtnAiManagerGoToPage_Click" ToolTip="Switch to the selected item's source page"/>
                        <Button Content="Run AI" Click="BtnAiManagerRunAi_Click" Style="{StaticResource ManagerPrimaryButton}" ToolTip="Run AI for the selected eligible item"/>
                        <TextBlock Text="Batch" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Run New" Click="BtnRunNewBookmarks_Click" ToolTip="Run all new queued AI bookmark requests"/>
                        <Button Content="Retry Failed" Click="BtnRetryFailedBookmarks_Click" Margin="0,0,12,4" ToolTip="Retry failed AI bookmark requests"/>
                        <TextBlock Text="Markers" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Create Set" Click="BtnCreateMarkerSet_Click" ToolTip="Create a named marker set from reviewed markers"/>
                        <Button Content="Marker Sets" Click="BtnManageMarkerSets_Click" ToolTip="Manage saved marker sets"/>
                        <Button Content="Export Markers" Click="BtnExportMarkers_Click" Margin="0,0,12,4" ToolTip="Export reviewed AI markers"/>
                    </WrapPanel>
                    </Border>
                    <DataGrid x:Name="AiManagerGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="True"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeShort}" Width="110"/>
                            <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="110"/>
                            <DataGridTextColumn Header="Observation" Binding="{Binding TextPreview}" Width="520"/>
                            <DataGridTextColumn Header="Quality" Binding="{Binding QualityPreview}" Width="220"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="3D" Tag="3DManager">
                <DockPanel Margin="8" Style="{StaticResource ManagerSurface}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ManagerToolbarBand}">
                    <WrapPanel Orientation="Horizontal" Style="{StaticResource ManagerToolbar}">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource ManagerButton}"/>
                        </WrapPanel.Resources>
                        <TextBlock Text="Build" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Auto" Click="Btn3dAutoBuildWalls_Click" Style="{StaticResource ManagerPrimaryButton}" ToolTip="Auto-build walls, sqft slabs, and RF/roof areas when available"/>
                        <Button Content="Wall" Click="Btn3dBuildWalls_Click" Style="{StaticResource ManagerPrimaryButton}" ToolTip="Build wall prisms from selected line takeoffs"/>
                        <Button Content="Roof Base" Click="Btn3dRfRoof_Click" Style="{StaticResource ManagerPrimaryButton}" ToolTip="Create a roof footprint from selected area takeoffs"/>
                        <Button Content="Select Edge" Click="Btn3dRoofEdges_Click" Style="{StaticResource ManagerPrimaryButton}" ToolTip="Select roof base edges on the sheet; save per-edge pitch from the side panel"/>
                        <Button Content="Generate Roof" Click="Btn3dBuildRoof_Click" Style="{StaticResource ManagerPrimaryButton}" Margin="0,0,12,4" ToolTip="Build ridge, hip, and valley geometry from the saved per-edge roof pitches"/>
                        <TextBlock Text="Rafters" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Pick Faces" Click="Btn3dRafterFaces_Click" ToolTip="Click roof faces in the 3D view to toggle rafters on each face"/>
                        <Button Content="Whole Roof" Click="Btn3dRafterAll_Click" ToolTip="Lay rafters on every face of every generated roof"/>
                        <ComboBox x:Name="CmbRafterSpacing" Width="58" SelectionChanged="CmbRafter_Changed" VerticalAlignment="Center" Margin="0,0,4,4" ToolTip="Rafter spacing o.c. (measured horizontally along the eave)"/>
                        <ComboBox x:Name="CmbRafterSize" Width="62" SelectionChanged="CmbRafter_Changed" VerticalAlignment="Center" Margin="0,0,4,4" ToolTip="Rafter member size; depth extrudes below the roof plane and walls trim to the rafter underside"/>
                        <Button Content="Clear" Click="Btn3dRafterClear_Click" Margin="0,0,12,4" ToolTip="Remove rafters from all roofs"/>
                        <TextBlock Text="Viewer" Style="{StaticResource ManagerGroupLabel}"/>
                        <Button Content="Fit" Click="Btn3dViewerFit_Click" ToolTip="Fit the clean 3D viewer scene"/>
                        <Button Content="Iso" Click="Btn3dViewerIso_Click" ToolTip="Show isometric view"/>
                        <Button Content="Top" Click="Btn3dViewerTop_Click" ToolTip="Show top view"/>
                        <Button Content="Front" Click="Btn3dViewerFront_Click" ToolTip="Show front view"/>
                        <Button Content="Reset" Click="Btn3dViewerReset_Click" Margin="0,0,12,4" ToolTip="Reset the 3D camera view"/>
                    </WrapPanel>
                    </Border>
                    <Grid x:Name="ThreeDViewerViewportHost"
                          MouseLeftButtonDown="ThreeDViewerViewport_MouseLeftButtonDown"
                          MouseLeftButtonUp="ThreeDViewerViewport_MouseLeftButtonUp"
                          MouseRightButtonDown="ThreeDViewerViewport_MouseRightButtonDown"
                          MouseRightButtonUp="ThreeDViewerViewport_MouseRightButtonUp"
                          MouseMove="ThreeDViewerViewport_MouseMove"
                          MouseWheel="ThreeDViewerViewport_MouseWheel">
                        <!-- Background set theme-aware from ApplyThreeDViewportTheme. -->
                        <Viewport3D x:Name="ThreeDViewerViewport"
                                    ClipToBounds="True">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="ThreeDViewerCamera"
                                                   Position="18,14,18"
                                                   LookDirection="-18,-10,-18"
                                                   UpDirection="0,1,0"
                                                   FieldOfView="42"/>
                            </Viewport3D.Camera>
                        </Viewport3D>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Opacity="0.92"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="Txt3dManagerSummary"
                                       Text="3D viewer ready. Select takeoff lines, then use 3D > Wall or the Wall button."
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Settings" Tag="SettingsManager">
                <DockPanel x:Name="SettingsManagerRoot" Margin="8" Style="{StaticResource ManagerSurface}"/>
            </TabItem>
        </TabControl>

    </DockPanel>
    <Grid x:Name="BusyOverlay"
          Panel.ZIndex="1000"
          Visibility="Collapsed"
          Background="#66000000"
          IsHitTestVisible="True">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="240"
                MaxWidth="360"
                Padding="18"
                CornerRadius="4"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse Width="42"
                             Height="42"
                             Stroke="#D1D5DB"
                             StrokeThickness="4"/>
                    <Ellipse Width="42"
                             Height="42"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="4"
                             StrokeDashArray="2 4"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="BusySpinnerRotate"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="BusySpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="BusyOverlayText"
                           Text="Working..."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource ControlForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
