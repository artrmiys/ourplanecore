<Window x:Class="OurPlaneCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ourplanecore" Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        Icon="Assets/ourplanecore.ico"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Ribbon vocabulary (TopCommand*, Ribbon*) lives in App.xaml so dialogs can share it. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootFrame">
    <DockPanel x:Name="RootDock">

        <TabControl x:Name="TopMainTabs"
                    DockPanel.Dock="Top"
                    ItemContainerStyle="{StaticResource CommandTabItem}"
                    Template="{StaticResource SegmentedTabControl}"
                    VerticalAlignment="Top"
                    FontSize="11"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}">
            <TabItem Header="Main">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,1">

                        <!-- GROUP: JOB -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnOpenImportMenu_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Open jobs, switch job folders, create jobs, or import PDF/PlanSwift into the current job">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconFolderOpen}"/>
                                            <TextBlock Text="Open / Import" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnImportPlanSwiftJob_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Separate PlanSwift job converter">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconImport}"/>
                                            <TextBlock Text="PlanSwift" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnImportPdfTakeoffs_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Import PDF pages and measurement annotations as takeoffs">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconSheetMeasure}"/>
                                            <TextBlock Text="PDF Takeoffs" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="JOB" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: PDF -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnExportPdf_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Export selected/all sheets to a PDF">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconExport}"/>
                                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnAutoRenamePdf_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Preview and apply PDF sheet names">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconTag}"/>
                                            <TextBlock Text="Name" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnAutoScalePdf_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Preview and apply PDF sheet scale">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconRuler}"/>
                                            <TextBlock Text="Scale" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnAutoRenameScalePdf_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Preview and apply PDF sheet names and scale">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconClipboard}"/>
                                            <TextBlock Text="Name+Scale" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnQueuePdfMetadataFallback_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Queue GPT fallback for missing PDF sheet metadata">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconSparkle}"/>
                                            <TextBlock Text="AI Fill" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnPdfMetadataCropHints_Click" Style="{StaticResource TopCommandButton}"
                                            ToolTip="Draw reusable AI Fill crop boxes for sheet number and scale">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconCrop}"/>
                                            <TextBlock Text="Crop Hints" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="PDF" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Page">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,1">

                        <!-- GROUP: ADD -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageAddPages_Click" Style="{StaticResource TopCommandButton}" ToolTip="Import PDF pages into the current job">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconAddPages}"/><TextBlock Text="Add Pages" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnNewBlankPage_Click" Style="{StaticResource TopCommandButton}" ToolTip="Create an empty sheet in the current job without selecting a PDF">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconBlankSheet}"/><TextBlock Text="Blank Sheet" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnImportPdfTakeoffs_Click" Style="{StaticResource TopCommandButton}" ToolTip="Import PDF pages plus PDF measurement annotations into takeoffs">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconSheetMeasure}"/><TextBlock Text="PDF Takeoffs" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="ADD" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: ROTATE -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageRotateLeft_Click" Style="{StaticResource TopCommandButton}" ToolTip="Rotate the active page left">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconRotateLeft}"/><TextBlock Text="Left" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnPageRotateRight_Click" Style="{StaticResource TopCommandButton}" ToolTip="Rotate the active page right">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconRotateRight}"/><TextBlock Text="Right" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnPageRotate180_Click" Style="{StaticResource TopCommandButton}" ToolTip="Rotate the active page 180 degrees">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconRotate180}"/><TextBlock Text="180" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageLevel_Click" Style="{StaticResource TopCommandButton}" ToolTip="Reset page view to fit and clear temporary drawing input">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconLevel}"/><TextBlock Text="Level" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnPageBatchRotate_Click" Style="{StaticResource TopCommandButton}" ToolTip="Rotate selected pages">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconRotateRight}"/><TextBlock Text="Batch Rotate" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="ROTATE" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: FLIP -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageFlipVertical_Click" Style="{StaticResource TopCommandButton}" ToolTip="Flip the active page vertically">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconFlipV}"/><TextBlock Text="Vertical" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageFlipHorizontal_Click" Style="{StaticResource TopCommandButton}" ToolTip="Flip the active page horizontally">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconFlipH}"/><TextBlock Text="Horizontal" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="FLIP" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: IMAGE -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageInvert_Click" Style="{StaticResource TopCommandButton}" ToolTip="Invert the active page colors">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconInvert}"/><TextBlock Text="Invert" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnPageCopyToClipboard_Click" Style="{StaticResource TopCommandButton}" ToolTip="Copy a rendered PNG of the active page to the clipboard">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconCopy}"/><TextBlock Text="Copy" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageCropNew_Click" Style="{StaticResource TopCommandButton}" ToolTip="Create a new page from the currently visible viewport area">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconCrop}"/><TextBlock Text="Crop New Page" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="IMAGE" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: PAGE -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageBatchRename_Click" Style="{StaticResource TopCommandButton}" ToolTip="Rename selected pages in order">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconRename}"/><TextBlock Text="Batch Rename" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnPageSetOrigin_Click" Style="{StaticResource TopCommandButton}" ToolTip="Mark the current visible page center as the page origin">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconOrigin}"/><TextBlock Text="Set Origin" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Button Click="BtnPageOffsetOrigin_Click" Style="{StaticResource TopCommandButton}" ToolTip="Nudge the stored page origin">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconOffset}"/><TextBlock Text="Offset Origin" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Click="BtnPageClose_Click" Style="{StaticResource TopCommandButton}" ToolTip="Close the active page tab">
                                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconClose}"/><TextBlock Text="Close Page" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="PAGE" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Annotation">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,1">

                        <!-- GROUP: MARKUP TOOLS -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <RadioButton x:Name="BtnHighlight" Click="BtnTool_Click" Tag="drawhighlight"
                                                 GroupName="DrawingTool" ToolTip="Draw a transparent highlighter box (H)"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                    <RadioButton x:Name="BtnDrawLine" Click="BtnTool_Click" Tag="drawline"
                                                 GroupName="DrawingTool" ToolTip="Draw a simple non-takeoff line markup (D)"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                    <RadioButton x:Name="BtnDrawArrow" Click="BtnTool_Click" Tag="drawarrow"
                                                 GroupName="DrawingTool" ToolTip="Draw a simple non-takeoff arrow markup"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                    <RadioButton x:Name="BtnDrawRect" Click="BtnTool_Click" Tag="drawrect"
                                                 GroupName="DrawingTool" ToolTip="Draw a simple non-takeoff box markup"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <RadioButton x:Name="BtnDrawCloud" Click="BtnTool_Click" Tag="drawcloud"
                                                 GroupName="DrawingTool" ToolTip="Draw a cloud annotation"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                    <RadioButton x:Name="BtnDrawAreaAnnot" Click="BtnTool_Click" Tag="drawarea"
                                                 GroupName="DrawingTool" ToolTip="Draw a filled color area annotation"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                    <RadioButton x:Name="BtnNote" Click="BtnTool_Click" Tag="note"
                                                 GroupName="DrawingTool" ToolTip="Write a text note on the sheet (N)"
                                                 Style="{StaticResource ToolRadioFlat}"/>
                                    <!-- Kept for future use; replaced by the inline STYLE controls. -->
                                    <Button x:Name="BtnAnnotationMenu"
                                            Content="Style"
                                            Click="BtnAnnotationMenu_Click"
                                            Visibility="Collapsed"
                                            ToolTip="Annotation tools, color, and thickness"
                                            Style="{StaticResource TopCommandButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="MARKUP TOOLS" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: STYLE (thickness + color, inline for convenience) -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="2,0,6,0"
                                               FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Slider x:Name="SliderAnnotThickness" Width="120" VerticalAlignment="Center"
                                            Minimum="1" Maximum="12" SmallChange="0.5" LargeChange="2"
                                            ToolTip="Annotation line thickness"
                                            ValueChanged="SliderAnnotThickness_ValueChanged"/>
                                    <TextBlock x:Name="TxtAnnotThickness" Text="3 px" VerticalAlignment="Center"
                                               Margin="7,0,0,0" MinWidth="36" FontSize="11"/>
                                </StackPanel>
                                <StackPanel x:Name="AnnotationColorSwatches" Orientation="Horizontal" Margin="2,2,0,1"/>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="STYLE" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Viewport">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,1">

                        <!-- GROUP: LINES & AREA  (2 columns x 2 rows) -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Line" Style="{StaticResource RibbonRowLabel}"/>
                                        <Slider Grid.Column="1" x:Name="SldLineThickness" Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5"
                                                Style="{StaticResource RibbonSlider}"
                                                ValueChanged="SldLineThickness_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                                ToolTip="Line measurement thickness 0.25 - 4.0"/>
                                        <TextBox Grid.Column="2" x:Name="TxtMeasurementStrokeScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                                 KeyDown="TxtMeasurementStrokeScale_KeyDown" LostFocus="TxtMeasurementStrokeScale_LostFocus"
                                                 ToolTip="Type a line thickness 0.25 - 4.0 and press Enter"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Point" Style="{StaticResource RibbonRowLabel}"/>
                                        <Slider Grid.Column="1" x:Name="SldPointSize" Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5"
                                                Style="{StaticResource RibbonSlider}"
                                                ValueChanged="SldPointSize_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                                ToolTip="Count marker size 0.25 - 4.0"/>
                                        <TextBox Grid.Column="2" x:Name="TxtMeasurementPointScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                                 KeyDown="TxtMeasurementPointScale_KeyDown" LostFocus="TxtMeasurementPointScale_LostFocus"
                                                 ToolTip="Type a point size 0.25 - 4.0 and press Enter"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Edge" Style="{StaticResource RibbonRowLabel}"/>
                                        <Slider Grid.Column="1" x:Name="SldAreaEdge" Minimum="0.25" Maximum="4" SmallChange="0.25" LargeChange="0.5"
                                                Style="{StaticResource RibbonSlider}"
                                                ValueChanged="SldAreaEdge_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                                ToolTip="Area boundary thickness 0.25 - 4.0"/>
                                        <TextBox Grid.Column="2" x:Name="TxtAreaEdgeScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                                 KeyDown="TxtAreaEdgeScale_KeyDown" LostFocus="TxtAreaEdgeScale_LostFocus"
                                                 ToolTip="Type an area edge thickness 0.25 - 4.0 and press Enter"/>
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fill" Style="{StaticResource RibbonRowLabel}"/>
                                        <Slider Grid.Column="1" x:Name="SldAreaFill" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                                Style="{StaticResource RibbonSlider}"
                                                ValueChanged="SldAreaFill_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                                ToolTip="Area fill opacity 0 - 100 %"/>
                                        <TextBox Grid.Column="2" x:Name="TxtAreaFillOpacity" Text="24" Style="{StaticResource RibbonValue}"
                                                 KeyDown="TxtAreaFillOpacity_KeyDown" LostFocus="TxtAreaFillOpacity_LostFocus"
                                                 ToolTip="Type an area fill opacity 0 - 100 % and press Enter"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="LINES &amp; AREA" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: RULER -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ruler" Style="{StaticResource RibbonRowLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SldRulerThickness" Minimum="0.5" Maximum="6" SmallChange="0.25" LargeChange="0.5"
                                            Style="{StaticResource RibbonSlider}"
                                            ValueChanged="SldRulerThickness_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                            ToolTip="Ruler screen thickness 0.5 - 6 px"/>
                                    <TextBox Grid.Column="2" x:Name="TxtRulerStrokeWidth" Text="1.0" Style="{StaticResource RibbonValue}"
                                             KeyDown="TxtRulerStrokeWidth_KeyDown" LostFocus="TxtRulerStrokeWidth_LostFocus"
                                             ToolTip="Type ruler thickness 0.5 - 6 px and press Enter"/>
                                </Grid>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="RULER" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: PDF SNAP -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bridge" Style="{StaticResource RibbonRowLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SldPdfSnapBridgeTolerance" Minimum="4" Maximum="96" SmallChange="2" LargeChange="8"
                                            Style="{StaticResource RibbonSlider}"
                                            ValueChanged="SldPdfSnapBridgeTolerance_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                            ToolTip="PDF Snap Tab continuation radius 4 - 96 screen px"/>
                                    <TextBox Grid.Column="2" x:Name="TxtPdfSnapBridgeTolerance" Text="36" Style="{StaticResource RibbonValue}"
                                             KeyDown="TxtPdfSnapBridgeTolerance_KeyDown" LostFocus="TxtPdfSnapBridgeTolerance_LostFocus"
                                             ToolTip="Type PDF Snap continuation radius 4 - 96 screen px and press Enter"/>
                                </Grid>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="PDF SNAP" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Display">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,1">

                        <!-- GROUP: LABELS -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplayMeasurementLabels" Content="All" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Master toggle for all measurement value labels"/>
                                <CheckBox x:Name="ChkDisplayLineLabels" Content="Line" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show length label on each line measurement"/>
                                <CheckBox x:Name="ChkDisplayAreaLabels" Content="Area" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show area label on each area measurement"/>
                                <CheckBox x:Name="ChkDisplayJoistLabels" Content="Joist" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show joist summary and segment labels on area joist layouts"/>
                                <CheckBox x:Name="ChkDisplayCountLabels" Content="Count" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show count label on each count measurement"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Size" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider x:Name="SldLabelScale" Minimum="0.5" Maximum="3" SmallChange="0.25" LargeChange="0.5"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldLabelScale_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Value label size 0.5 - 3.0"/>
                                <TextBox x:Name="TxtMeasurementLabelScale" Text="1.0" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtMeasurementLabelScale_KeyDown" LostFocus="TxtMeasurementLabelScale_LostFocus"
                                         ToolTip="Type a label size 0.5 - 3.0 and press Enter"/>
                                <CheckBox x:Name="ChkDisplayLabelsScaleWithPage" Content="w/ page" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          Margin="6,0,7,0"
                                          ToolTip="Off (default): labels keep a fixed screen size when zooming. On: labels grow/shrink with page zoom."/>
                            </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="LABELS" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: OVERLAYS -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Legend" Style="{StaticResource RibbonRowLabel}"/>
                                <CheckBox x:Name="ChkDisplayLegend" Content="Show" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Show or hide the legend overlay on the active sheet"/>
                                <Button Content="Size" Click="BtnLegendSizeMenu_Click" Style="{StaticResource TopCommandButton}"
                                        ToolTip="Pick legend size preset"/>
                                <Button Content="Pos" Click="BtnLegendPositionMenu_Click" Style="{StaticResource TopCommandButton}"
                                        ToolTip="Pick legend anchor (corner/edge of the sheet)"/>
                                <CheckBox x:Name="ChkDisplayLegendScaleWithPage" Content="w/page" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Off (default): legend keeps a fixed screen size when zooming. On: legend grows/shrinks with page zoom."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Header" Style="{StaticResource RibbonRowLabel}"/>
                                <Button Content="Size" Click="BtnScaleHeaderSizeMenu_Click" Style="{StaticResource TopCommandButton}"
                                        ToolTip="Pick header size preset"/>
                                <CheckBox x:Name="ChkDisplayHeaderScaleWithPage" Content="w/page" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Off (default): header keeps a fixed screen size when zooming. On: header grows/shrinks with page zoom."/>
                                <CheckBox x:Name="ChkDisplaySimplifyNavigation" Content="Fast pan/zoom" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          Margin="6,0,7,0"
                                          ToolTip="Simplify overlays while panning or zooming. Faster on heavy sheets, off by default for full visual quality."/>
                                <CheckBox x:Name="ChkDisplayPdfLayers" Content="PDF layers" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          Margin="0,0,7,0"
                                          ToolTip="Enable the PDF Layers panel and per-page layer scanning. Off by default: pages render faster without layer discovery."/>
                            </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="OVERLAYS" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RibbonGroupSep}"/>

                        <!-- GROUP: UNITS / VIEW -->
                        <StackPanel Style="{StaticResource RibbonGroup}">
                            <StackPanel Style="{StaticResource RibbonGroupBody}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox x:Name="ChkDisplayImperial" Content="ft / sf" Click="DisplaySetting_Click" Style="{StaticResource TopCommandCheckBox}"
                                          ToolTip="Imperial units (ft / sf / ea). Off = metric."/>
                                <TextBlock Text="Render" Style="{StaticResource RibbonRowLabel}"/>
                                <ComboBox x:Name="ComboViewportRenderQuality" Width="92" Height="22" FontSize="11" Margin="0,0,5,0"
                                          SelectionChanged="ComboViewportRenderQuality_SelectionChanged"
                                          ToolTip="Viewport PDF render RAM/quality profile">
                                    <ComboBoxItem Content="Balanced"/>
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Max"/>
                                </ComboBox>
                                <TextBlock Text="Edge" Style="{StaticResource RibbonRowLabel}"/>
                                <ComboBox x:Name="ComboDisplayViewportBackground" Width="96" Height="22" FontSize="11" Margin="0,0,5,0"
                                          SelectionChanged="ComboDisplayViewportBackground_SelectionChanged"
                                          ToolTip="Choose the background around the sheet">
                                    <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="Gray" Tag="#F2F2F2"/>
                                    <ComboBoxItem Content="Dark" Tag="#2B2B2B"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Paper" Style="{StaticResource RibbonRowLabel}"/>
                                <ComboBox x:Name="ComboDisplayPageBackground" Width="96" Height="22" FontSize="11" Margin="0,0,5,0"
                                          SelectionChanged="ComboDisplayPageBackground_SelectionChanged"
                                          ToolTip="Choose a softer page background tint">
                                    <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="Soft gray" Tag="#F2F2F2"/>
                                    <ComboBoxItem Content="Medium gray" Tag="#D8D8D8"/>
                                    <ComboBoxItem Content="Dark gray" Tag="#B8B8B8"/>
                                    <ComboBoxItem Content="Warm" Tag="#FFF8E8"/>
                                    <ComboBoxItem Content="Soft green" Tag="#EFF7ED"/>
                                    <ComboBoxItem Content="Black" Tag="#000000"/>
                                </ComboBox>
                                <ToggleButton x:Name="BtnDisplayDarkTheme" Content="Dark" Checked="BtnDarkTheme_Checked" Unchecked="BtnDarkTheme_Unchecked"
                                              Style="{StaticResource TopCommandToggle}"
                                              ToolTip="Toggle dark/light UI theme"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Zoom" Style="{StaticResource RibbonRowLabel}"/>
                                <Slider x:Name="SldZoomWheelFactor" Minimum="1.05" Maximum="2.5" SmallChange="0.05" LargeChange="0.25"
                                        Style="{StaticResource RibbonSlider}"
                                        ValueChanged="SldZoomWheelFactor_ValueChanged" PreviewMouseUp="Slider_CommitSave" KeyUp="Slider_CommitSave"
                                        ToolTip="Mouse-wheel zoom step per notch 1.05 - 2.5x (PlanSwift-fast at 2x)"/>
                                <TextBox x:Name="TxtZoomWheelFactor" Text="2.0" Style="{StaticResource RibbonValue}"
                                         KeyDown="TxtZoomWheelFactor_KeyDown" LostFocus="TxtZoomWheelFactor_LostFocus"
                                         ToolTip="Type a wheel zoom step 1.05 - 2.5x and press Enter"/>
                            </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RibbonGroupCap}">
                                <TextBlock Text="UNITS &amp; VIEW" Style="{StaticResource RibbonGroupLabel}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusJob" Text="No job"
                           FontWeight="Normal" Margin="0,0,4,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem MinWidth="150">
                <TextBlock x:Name="TxtStatusPage" Text="—"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus"
                           Text="Ready. Open or create a job to start."/>
            </StatusBarItem>
        </StatusBar>

        <!-- Toolbar -->
        <!-- Bottom command strip: two full-width rows (spread edge to edge) -->
        <StackPanel x:Name="BottomToolStrip" DockPanel.Dock="Bottom"
                    Background="{DynamicResource ControlBackgroundBrush}">

        <!-- Row 1: drawing & measurement tools (centered) -->
        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" Padding="6,3,6,2">
            <DockPanel LastChildFill="True">
            <Button x:Name="BtnExportCurrentExcelCell" DockPanel.Dock="Right"
                    Content="Excel"
                    Click="BtnExportCurrentExcel_Click"
                    Style="{StaticResource ToolBtn}"
                    VerticalAlignment="Center"
                    Margin="8,0,2,0"
                    ToolTip="Write the selected takeoff folder/item to the active cell in an already open Excel workbook"/>
            <WrapPanel x:Name="ToolStripRow1" Orientation="Horizontal"
                       HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock x:Name="TxtJobName" VerticalAlignment="Center"
                       Text="— no job —" FontSize="11" Margin="4,0"
                       FontWeight="Normal"
                       MaxWidth="118"
                       TextTrimming="CharacterEllipsis"/>

            <Border Style="{StaticResource ToolDiv}"/>

            <!-- Drawing tools (radio group) -->
            <RadioButton x:Name="BtnPan"    Content="Pan"    Click="BtnTool_Click" Tag="pan"
                         GroupName="DrawingTool" ToolTip="Pan (V)"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnSelect" Content="Select" Click="BtnTool_Click" Tag="select"
                         GroupName="DrawingTool" IsChecked="True"
                         ToolTip="Box select measurements (E). Ctrl+C copy, Ctrl+V paste"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnScale"  Content="Scale"  Click="BtnTool_Click" Tag="scale"
                         GroupName="DrawingTool" ToolTip="Set scale (S)"
                         Style="{StaticResource ToolRadio}"/>
            <Grid Margin="0,0,2,0">
                <RadioButton x:Name="BtnRuler" Click="BtnTool_Click" Tag="ruler"
                             GroupName="DrawingTool" ToolTip="Place a dimension/ruler markup on the PDF (R)"
                             Style="{StaticResource ToolRadio}"
                             Margin="0" MinWidth="58" Padding="7,3,20,3"/>
                <ToggleButton x:Name="BtnRulerSheetVisibility"
                              Width="14" Height="14" Padding="0" Margin="0,0,3,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False"
                              Style="{StaticResource BookmarkDockToggleButton}"
                              Checked="BtnRulerSheetVisibility_Changed"
                              Unchecked="BtnRulerSheetVisibility_Changed"
                              ToolTip="Hide all ruler markups on this sheet"/>
            </Grid>
            <Border Style="{StaticResource ToolDiv}"/>
            <RadioButton x:Name="BtnPoint"  Content="Count"  Click="BtnTool_Click" Tag="point"
                         GroupName="DrawingTool" ToolTip="Create a new Count item and start recording (P). Use the active target Record button to continue an existing item"
                         Style="{StaticResource ToolRadio}"/>
            <Button x:Name="BtnSimilarCount"
                    Click="BtnSimilarCount_Click"
                    ToolTip="Find similar symbols on this sheet, name the result, and add reviewed markers as a Count item"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="74"
                    Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconSimilar}" Width="13" Height="13" Margin="0,0,4,0"/>
                    <TextBlock Text="Similar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnPointAlongLine"
                    Click="BtnPointAlongLine_Click"
                    ToolTip="Create Count points along selected Line measurement(s) with a spacing"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="62"
                    Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconPointAlongLine}" Width="13" Height="13" Margin="0,0,4,0"/>
                    <TextBlock Text="P Line" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnCountSymbolDefault"
                    Content="O"
                    Click="BtnCountSymbolDefault_Click"
                    ToolTip="Default Count display for newly created Count takeoffs"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="28"
                    Padding="4,2"
                    Visibility="Collapsed"/>
            <RadioButton x:Name="BtnLine"   Content="Line"   Click="BtnTool_Click" Tag="line"
                         GroupName="DrawingTool" ToolTip="Create a new Line item and start recording (L). Use the active target Record button to continue an existing item"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnArea"   Content="Area"   Click="BtnTool_Click" Tag="area"
                         GroupName="DrawingTool" ToolTip="Create a new Area item and start recording (A). Use the active target Record button to continue an existing item"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnJoistArea" Content="J Area" Click="BtnTool_Click" Tag="joistarea"
                         GroupName="DrawingTool" ToolTip="Create a new Joist Area item and start recording (J)"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnBeam" Content="Beam" Click="BtnTool_Click" Tag="beam"
                         GroupName="DrawingTool" ToolTip="Measure a beam length, create a Count item, and place the first Count mark (B)"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnOpenings" Content="Open" Click="BtnTool_Click" Tag="openings"
                         GroupName="DrawingTool" ToolTip="Measure an opening box, create a Count item, and place the Count mark in the center (O)"
                         Style="{StaticResource ToolRadio}"/>
            <RadioButton x:Name="BtnAreaCut" Content="Cut" Click="BtnTool_Click" Tag="areacut"
                         GroupName="DrawingTool" ToolTip="Cut Area holes or erase Line pieces (X, F9 toggles box)"
                         Style="{StaticResource ToolRadio}"/>
            <Button x:Name="BtnMergeSelectedMeasurements"
                    Content="Merge"
                    Click="BtnMergeSelectedMeasurements_Click"
                    ToolTip="Merge selected measurement segments into another takeoff (Ctrl+M)"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="58"
                    Padding="6,2"/>
            <Button x:Name="BtnSplitSelectedMeasurements"
                    Content="Split"
                    Click="BtnSplitSelectedMeasurements_Click"
                    ToolTip="Split selected measurement segments to a new takeoff (Ctrl+Shift+M)"
                    Style="{StaticResource ToolBtn}"
                    MinWidth="52"
                    Padding="6,2"/>
            <Border Style="{StaticResource ToolDiv}"/>
            <ToggleButton x:Name="BtnSnap" Content="Snap"
                          ToolTip="Snap to existing takeoff points (F3)"
                          Checked="BtnSnap_Checked" Unchecked="BtnSnap_Unchecked"
                          Padding="6,2" MinWidth="48"/>
            <ToggleButton x:Name="BtnPdfSnap" Content="PDF"
                          ToolTip="Snap to PDF vector corners and points (Ctrl+F3)"
                          Checked="BtnPdfSnap_Checked" Unchecked="BtnPdfSnap_Unchecked"
                          Padding="6,2" MinWidth="44"/>
            <ToggleButton x:Name="BtnOrtho" Content="Ortho"
                          ToolTip="Lock Line/Area to 90/45 degrees (F8, Shift temporarily toggles)"
                          Checked="BtnOrtho_Checked" Unchecked="BtnOrtho_Unchecked"
                          Padding="6,2" MinWidth="52"/>
            <ToggleButton x:Name="BtnBoxMode" Content="Box"
                          ToolTip="Draw Line/Area measurements by two opposite box corners (F9)"
                          Checked="BtnBoxMode_Checked" Unchecked="BtnBoxMode_Unchecked"
                          Padding="6,2" MinWidth="44"/>

            </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Row 2: Transform (inline), sheet scale, AI, status (centered) -->
        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" Padding="6,2,6,3">
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Transform" VerticalAlignment="Center" FontSize="11" Margin="2,0,6,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            <Button x:Name="BtnMirrorHorizontal" Content="Flip H" Click="BtnMirrorHorizontal_Click"
                    ToolTip="Mirror selected measurements/markups horizontally"
                    Style="{StaticResource ToolBtn}" MinWidth="52"/>
            <Button x:Name="BtnMirrorVertical" Content="Flip V" Click="BtnMirrorVertical_Click"
                    ToolTip="Mirror selected measurements/markups vertically"
                    Style="{StaticResource ToolBtn}" MinWidth="52"/>
            <TextBlock Text="Rot" VerticalAlignment="Center" FontSize="11" Margin="10,0,2,0"/>
            <Slider x:Name="SliderRotateSelection"
                    Width="110"
                    VerticalAlignment="Center"
                    Minimum="-180"
                    Maximum="180"
                    Value="0"
                    TickFrequency="15"
                    Style="{StaticResource RibbonSlider}"
                    ValueChanged="SliderRotateSelection_ValueChanged"
                    ToolTip="Rotate selected geometry around its center; hold Shift for 15 deg steps"/>
            <Button x:Name="BtnResetRotateSelection" Content="0" Click="BtnResetRotateSelection_Click"
                    ToolTip="Center rotate slider for another relative adjustment"
                    Style="{StaticResource ToolBtn}" MinWidth="24"/>
            <TextBlock Text="Scale" VerticalAlignment="Center" FontSize="11" Margin="10,0,2,0"/>
            <Slider x:Name="SliderScaleSelection"
                    Width="100"
                    VerticalAlignment="Center"
                    Minimum="0.25"
                    Maximum="3"
                    Value="1"
                    TickFrequency="0.25"
                    Style="{StaticResource RibbonSlider}"
                    ValueChanged="SliderScaleSelection_ValueChanged"
                    ToolTip="Scale selected geometry around its center"/>
            <TextBox x:Name="TxtScaleSelectionFactor"
                     Width="44"
                     VerticalAlignment="Center"
                     Text="1x"
                     Style="{StaticResource RibbonValue}"
                     KeyDown="TxtScaleSelectionFactor_KeyDown"
                     LostFocus="TxtScaleSelectionFactor_LostFocus"
                     ToolTip="Type selected-geometry scale, e.g. 1.25x or 125%, and press Enter"/>

            <Border Style="{StaticResource ToolDiv}"/>

            <!-- Sheet scale -->
            <Label Content="Scale:" VerticalAlignment="Center" Padding="0"/>
            <TextBox x:Name="TxtScaleRatio" Width="112" VerticalAlignment="Center"
                     Text="100" ToolTip="Scale ratio (1:N) - press Enter to apply"
                     KeyDown="TxtScaleRatio_KeyDown"/>
            <Button Content="Set" Click="BtnSetScale_Click"
                    ToolTip="Apply scale" Style="{StaticResource ToolBtn}"/>
            <Button Content="▾ Presets" Click="BtnScalePresets_Click"
                    ToolTip="Common scale presets" Style="{StaticResource ToolBtn}"/>
            <TextBlock x:Name="TxtScaleInfo" VerticalAlignment="Center"
                       FontSize="11" Margin="4,0"/>

            <Border Style="{StaticResource ToolDiv}"/>
            <Button x:Name="BtnOpenAiSettings" Content="AI Settings"
                    ToolTip="OpenAI key status and model settings"
                    Click="BtnOpenAiSettings_Click"
                    Style="{StaticResource ToolBtn}"/>

            <Border Style="{StaticResource ToolDiv}"/>
            <Button Content="Fit"  Click="BtnFit_Click"    ToolTip="Fit page (F)"
                    Style="{StaticResource ToolBtn}"/>
            <Button Content="+"    Click="BtnZoomIn_Click"  ToolTip="Zoom in (Ctrl++)"
                    MinWidth="28" Style="{StaticResource ToolBtn}"/>
            <Button Content="-"    Click="BtnZoomOut_Click" ToolTip="Zoom out (Ctrl+-)"
                    MinWidth="28" Style="{StaticResource ToolBtn}"/>

            <Border Style="{StaticResource ToolDiv}"/>
            <TextBlock x:Name="TxtTool" VerticalAlignment="Center"
                       Text="Tool: Pan" FontSize="11" Margin="2,0"/>

            </WrapPanel>
        </Border>
        </StackPanel>

        <!-- Main area: 3-column content + AI Inbox -->
        <TabControl x:Name="WorkspaceTabs"
                    SelectionChanged="WorkspaceTabs_SelectionChanged"
                    ItemContainerStyle="{StaticResource WorkspaceTabItem}"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Foreground="{DynamicResource ControlForegroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}">
            <TabItem Header="Main View" Tag="MainView">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="280"/>
                <RowDefinition x:Name="InboxSplitterRow" Height="0"/>
                <RowDefinition x:Name="InboxRow" Height="30" MinHeight="30"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 3-column layout -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PagesColumn" Width="200" MinWidth="120"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"   MinWidth="400"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition x:Name="TakeoffsColumn" Width="300" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: Pages -->
                <DockPanel x:Name="PagesPanel" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                           SizeChanged="SidePanel_SizeChanged">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorder}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Grid Margin="0,0,4,0" VerticalAlignment="Center">
                                    <Button x:Name="BtnPagesTileSecondMonitor"
                                            Content="Tile M2"
                                            Click="BtnPagesTileSecondMonitor_Click"
                                            Padding="7,2,22,2"
                                            FontSize="11"
                                            MinWidth="80"
                                            ToolTip="Open selected Pages sheets in detached windows and tile them on monitor 2"/>
                                    <ToggleButton x:Name="BtnPagesTileSecondMonitorVertical"
                                                  Style="{StaticResource BookmarkDockToggleButton}"
                                                  Margin="0,0,6,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Checked="BtnPagesTileSecondMonitorVertical_Changed"
                                                  Unchecked="BtnPagesTileSecondMonitorVertical_Changed"
                                                  ToolTip="Toggle vertical Tile M2 layout (filled = vertical)"/>
                                </Grid>
                                <Button x:Name="BtnPagesOpenMenu"
                                        Content="Open  ▾"
                                        Click="DropdownButton_Click"
                                        Padding="7,2"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                        ToolTip="Open the selected Pages sheets">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open as Tabs" Click="BtnPagesOpenTabs_Click"/>
                                            <MenuItem Header="Detach to windows" Click="BtnPagesDetach_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="BtnRefreshPagesTree"
                                        Content="R"
                                        Click="BtnRefreshPagesTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Refresh Pages tree"/>
                                <Button x:Name="BtnCollapsePagesTree"
                                        Content="-"
                                        Click="BtnCollapsePagesTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Collapse all Pages nodes"/>
                                <Button x:Name="BtnExpandPagesTree"
                                        Content="+"
                                        Click="BtnExpandPagesTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Expand all Pages nodes"/>
                            </StackPanel>
                            <TextBlock Text="Pages"
                                       Style="{StaticResource PanelHeader}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- Quick bar: same 38px height as the Takeoffs active-target bar so the
                         search rows of both panels sit on one horizontal line. -->
                    <Border x:Name="PagesQuickBar"
                            DockPanel.Dock="Top"
                            Height="38"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="4,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboFolderTemplateMode"
                                      Grid.Column="0"
                                      SelectionChanged="ComboFolderTemplateMode_SelectionChanged"
                                      FontSize="11"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      ToolTip="Folder template mode for Pages and Takeoffs">
                                <ComboBoxItem Content="Auto"/>
                                <ComboBoxItem Content="COM"/>
                                <ComboBoxItem Content="EWP"/>
                            </ComboBox>
                            <Button x:Name="BtnNewPageFolderDirect"
                                    Grid.Column="1"
                                    Content="Folder"
                                    Click="BtnNewPageFolder_Click"
                                    Padding="2,3"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    ToolTip="Create a new folder under the selected Pages folder"/>
                            <Button x:Name="BtnNewPageMenu"
                                    Grid.Column="2"
                                    Content="+ New ▾"
                                    Click="DropdownButton_Click"
                                    Padding="2,3"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    ToolTip="Create pages and folders">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="New Folder" Click="BtnNewPageFolder_Click"/>
                                        <MenuItem Header="Blank Sheet" Click="BtnNewBlankPage_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Auto Folders" Click="BtnAutoPageFolders_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="BtnPageSetupMenu"
                                    Grid.Column="3"
                                    Content="Setup ▾"
                                    Click="DropdownButton_Click"
                                    Padding="2,3"
                                    FontSize="11"
                                    ToolTip="Page setup and sorting actions">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Name / Scale…" Click="BtnFloatingPageSetup_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Sort: A → Arch / S → Struct" Click="BtnSortPagesArchStruct_Click"/>
                                        <MenuItem Header="Sort: D / Sec / WT suffix" Click="BtnSortPagesSuffix_Click"/>
                                        <MenuItem Header="Repair page links" Click="BtnRepairMeasurementPageLinks_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid x:Name="PagesAndBookmarksHost" Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="BookmarksDockSplitterRow" Height="0"/>
                            <RowDefinition x:Name="BookmarksDockRow" Height="0" MinHeight="0"/>
                            <RowDefinition x:Name="TemplatesDockSplitterRow" Height="0"/>
                            <RowDefinition x:Name="TemplatesDockRow" Height="0" MinHeight="0"/>
                        </Grid.RowDefinitions>
                        <TabControl x:Name="PagesSideTabs"
                                    Grid.Row="0"
                                    AutomationProperties.AutomationId="PagesSideTabs"
                                    ItemContainerStyle="{StaticResource WorkspaceTabItem}"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    Foreground="{DynamicResource ControlForegroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}">
                            <TabItem Header="Pages">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top"
                                          Height="23"
                                          Margin="4,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0"
                                              Margin="0,0,2,0">
                                            <TextBox x:Name="PagesFolderSearchBox"
                                                     Padding="2,1,20,1"
                                                     FontSize="11"
                                                     AutomationProperties.Name="Page folder search"
                                                     TextChanged="PagesTreeSearchBox_TextChanged"
                                                     ToolTip="Search page folders by folder name"/>
                                            <ToggleButton x:Name="PagesFolderSearchCaseToggle"
                                                          Style="{StaticResource BookmarkDockToggleButton}"
                                                          IsChecked="True"
                                                          Margin="0,0,4,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Checked="PagesFolderSearchCaseToggle_Changed"
                                                          Unchecked="PagesFolderSearchCaseToggle_Changed"
                                                          ToolTip="Match page folder case exactly"/>
                                        </Grid>
                                        <TextBox x:Name="PagesTreeSearchBox"
                                                 Grid.Column="1"
                                                 Margin="2,0,0,0"
                                                 FontSize="11"
                                                 AutomationProperties.Name="Sheet search"
                                                 TextChanged="PagesTreeSearchBox_TextChanged"
                                                 ToolTip="Search sheets by sheet name"/>
                                    </Grid>
                                    <TreeView x:Name="PagesTree"
                                              AutomationProperties.AutomationId="PagesTree"
                                              SelectedItemChanged="PagesTree_SelectedItemChanged"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              HorizontalAlignment="Stretch"
                                              Margin="2"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="PDF Layers">
                                <DockPanel Margin="4">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                        <Button x:Name="BtnLayersLoad"
                                                Content="Load"
                                                Click="BtnLayersLoad_Click"
                                                Padding="3,1"
                                                Margin="0,0,4,0"
                                                FontSize="10"
                                                ToolTip="Scan PDF layers for the active page on demand"/>
                                        <Button x:Name="BtnLayersOn"
                                                Content="All On"
                                                Click="BtnLayersOn_Click"
                                                Padding="3,1"
                                                Margin="0,0,4,0"
                                                FontSize="10"/>
                                        <Button x:Name="BtnLayersOff"
                                                Content="All Off"
                                                Click="BtnLayersOff_Click"
                                                Padding="3,1"
                                                FontSize="10"/>
                                        <Button x:Name="BtnLayersClearHi"
                                                Content="Clear Hi"
                                                Click="BtnLayersClearHi_Click"
                                                Padding="3,1"
                                                Margin="4,0,0,0"
                                                FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                        <ToggleButton x:Name="BtnLayerTraceMode"
                                                      Content="Layer Trace"
                                                      Click="BtnLayerTraceMode_Click"
                                                      Padding="3,1"
                                                      Margin="0,0,4,0"
                                                      FontSize="10"/>
                                        <Button x:Name="BtnLayerTraceCycle"
                                                Content="Full"
                                                Click="BtnLayerTraceCycle_Click"
                                                Padding="3,1"
                                                Margin="0,0,4,0"
                                                FontSize="10"/>
                                        <Button x:Name="BtnLayerTraceApply"
                                                Content="Apply"
                                                Click="BtnLayerTraceApply_Click"
                                                Padding="3,1"
                                                FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtLayerTraceStatus"
                                               DockPanel.Dock="Top"
                                               Text="Select a layer for Layer Trace."
                                               FontSize="10"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LayersPanel" Margin="0"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                        <GridSplitter x:Name="BookmarksDockSplitter"
                                      Grid.Row="1"
                                      Height="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource SplitterBrush}"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="Collapsed"/>
                        <DockPanel x:Name="BookmarksDockPanel"
                                   Grid.Row="2"
                                   MinHeight="120"
                                   Background="{DynamicResource PanelBackgroundBrush}"
                                   Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorder}">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="BtnDockBookmarksBelowPages"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource BookmarkDockToggleButton}"
                                                  Margin="2,0,0,0"
                                                  Checked="BookmarkDockToggle_Changed"
                                                  Unchecked="BookmarkDockToggle_Changed"
                                                  ToolTip="Return Bookmarks to the tab list"/>
                                    <TextBlock Text="Bookmarks"
                                               Style="{StaticResource PanelHeader}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ContentControl x:Name="BookmarksDockContentHost"/>
                        </DockPanel>
                        <GridSplitter x:Name="TemplatesDockSplitter"
                                      Grid.Row="3"
                                      Height="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource SplitterBrush}"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="Collapsed"/>
                        <DockPanel x:Name="TemplatesDockPanel"
                                   Grid.Row="4"
                                   MinHeight="120"
                                   Background="{DynamicResource PanelBackgroundBrush}"
                                   Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorder}">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="BtnDockTemplatesBelowPages"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource BookmarkDockToggleButton}"
                                                  Margin="2,0,0,0"
                                                  Checked="TemplatesDockToggle_Changed"
                                                  Unchecked="TemplatesDockToggle_Changed"
                                                  ToolTip="Return Templates to the tab list"/>
                                    <TextBlock Text="Templates"
                                               Style="{StaticResource PanelHeader}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ContentControl x:Name="TemplatesDockContentHost"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              DragCompleted="SidePanelSplitter_DragCompleted"
                              Background="{DynamicResource SplitterBrush}" ResizeBehavior="PreviousAndNext"/>

                <!-- Centre: page tabs + PDF viewport -->
                <Grid x:Name="ViewportHost" Grid.Column="2"
                      Background="{DynamicResource SurfaceBackgroundBrush}"
                      AllowDrop="True"
                      DragOver="PageTabs_DragOver"
                      Drop="PageTabs_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vertical quick-command strips; content is built in MainWindow.SideStrips.cs -->
                    <Border x:Name="LeftCommandStripHost"
                            Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Width="26"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,1,0"/>
                    <Border x:Name="RightCommandStripHost"
                            Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            Width="26"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1,0,0,0"/>

                    <TabControl x:Name="PageTabs"
                                Grid.Row="0" Grid.Column="1"
                                Visibility="Collapsed"
                                MinHeight="28"
                                SelectionChanged="PageTabs_SelectionChanged"
                                AllowDrop="True"
                                DragOver="PageTabs_DragOver"
                                Drop="PageTabs_Drop"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                Foreground="{DynamicResource ControlForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"/>
                    <Grid x:Name="ViewportSurfaceHost"
                          Grid.Row="1" Grid.Column="1"
                          Background="#FFFFFF"
                          AllowDrop="True"
                          DragOver="PageTabs_DragOver"
                          Drop="PageTabs_Drop"
                          ClipToBounds="True"/>

                    <!-- Empty-state Start card: shown when no job is open -->
                    <Grid x:Name="NoJobOverlay"
                          Grid.Row="1" Grid.Column="1"
                          Panel.ZIndex="20"
                          Background="{DynamicResource WindowBackgroundBrush}"
                          Visibility="Collapsed">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="560"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="34,30">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="26" Height="26" CornerRadius="6"
                                            Background="{DynamicResource BrandAccentBrush}" Margin="0,0,11,0"/>
                                    <TextBlock Text="OurPlaneCore" FontSize="20" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ControlForegroundBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Construction takeoff — start by opening or creating a job."
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           FontSize="12.5" Margin="0,0,0,20"/>
                                <UniformGrid Columns="2">
                                    <Button Click="StartOpenRecent_Click" Height="58" Margin="0,0,8,8" Padding="14,8"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Pick from recently used jobs">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconFolderOpen}" Width="20" Height="20" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Open a recent job" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Recently used" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="StartNewBlank_Click" Height="58" Margin="0,0,0,8" Padding="14,8"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Create an empty job; add sheets later">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconPlus}" Width="20" Height="20" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="New blank job" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Start empty" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="StartNewFromPdf_Click" Height="58" Margin="0,0,8,0" Padding="14,8"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Create a job from a folder of PDF drawings">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconSheetMeasure}" Width="20" Height="20" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="New job from PDFs" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Import a folder of drawings" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="StartSample_Click" Height="58" Padding="14,8"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Open the bundled sample job to explore">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RibbonIcon}" Data="{StaticResource IconSparkle}" Width="20" Height="20" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Open sample job" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="Explore a demo" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           FontSize="11" Margin="0,18,0,0" HorizontalAlignment="Center">
                                    <Run Text="Open / Import is always in the ribbon"/>
                                    <Run Text="  ·  press "/><Run Text="F1" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/><Run Text=" for keyboard shortcuts"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- F1 keyboard shortcuts overlay -->
                    <Grid x:Name="ShortcutsOverlay" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="30"
                          Background="#B0000000" Visibility="Collapsed">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="28,22">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Keyboard shortcuts"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ControlForegroundBrush}"/>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Text="Esc to close  ·  F1 toggles"
                                               FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- TOOLS -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Style="{StaticResource KbdColHeader}" Text="TOOLS"/>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="V"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Pan"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="E"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Select"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="S"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Scale"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="R"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Ruler"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="P"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Count"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="L"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Line"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="A"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Area"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="J"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Joist Area"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="X"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Area Cut"/></DockPanel>
                                    </StackPanel>
                                    <!-- VIEWPORT -->
                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Style="{StaticResource KbdColHeader}" Text="VIEWPORT &amp; DRAW"/>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Space"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Start / stop recording"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="T"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="New takeoff item"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="C"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Complete drawing"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="F"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Fit page"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="F3"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Snap to points"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="F8"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Ortho"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="F9"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Box mode"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Esc"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Cancel current action"/></DockPanel>
                                    </StackPanel>
                                    <!-- EDIT / GLOBAL -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource KbdColHeader}" Text="EDIT &amp; GLOBAL"/>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+O"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Open job"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+S"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Save"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+Z"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Undo"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+C"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Copy"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+V"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Paste"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+M"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Merge segments"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+Shift+M"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Split segments"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="F2"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Rename in tree"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Del"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Delete selected"/></DockPanel>
                                        <DockPanel Style="{StaticResource KbdRow}"><Border Style="{StaticResource KbdKey}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl+Shift+P"/></Border><TextBlock Style="{StaticResource KbdAction}" Text="Command palette"/></DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ViewportLayerTraceBar"
                            Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,12,0"
                            Padding="4"
                            Background="#EFFFFFFF"
                            BorderBrush="#66000000"
                            BorderThickness="1"
                            CornerRadius="4"
                            Panel.ZIndex="8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnViewportLayerTraceToggle"
                                          Content="Manual"
                                          Click="BtnViewportLayerTraceToggle_Click"
                                          Padding="7,2"
                                          MinWidth="82"
                                          FontSize="11"
                                          ToolTip="Toggle Manual / PDF Layer Trace mode in the viewport"/>
                            <Button x:Name="BtnViewportLayerTraceCycle"
                                    Content="Full"
                                    Click="BtnViewportLayerTraceCycle_Click"
                                    Padding="7,2"
                                    Margin="4,0,0,0"
                                    MinWidth="58"
                                    FontSize="11"
                                    ToolTip="Cycle Layer Trace mode (Tab while Layer Trace is on)"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                              DragCompleted="SidePanelSplitter_DragCompleted"
                              Background="{DynamicResource SplitterBrush}" ResizeBehavior="PreviousAndNext"/>

                <!-- Right panel: Takeoffs -->
                <DockPanel x:Name="TakeoffsPanel" Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}"
                           SizeChanged="SidePanel_SizeChanged">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderBorder}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnRefreshTakeoffsTree"
                                        Content="R"
                                        Click="BtnRefreshTakeoffsTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Refresh Takeoffs tree"/>
                                <Button x:Name="BtnCollapseTakeoffsTree"
                                        Content="-"
                                        Click="BtnCollapseTakeoffsTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Collapse all Takeoffs nodes"/>
                                <Button x:Name="BtnExpandTakeoffsTree"
                                        Content="+"
                                        Click="BtnExpandTakeoffsTree_Click"
                                        Width="22"
                                        MinWidth="22"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        FontSize="11"
                                        ToolTip="Expand all Takeoffs nodes"/>
                            </StackPanel>
                            <TextBlock Text="Takeoffs"
                                       Style="{StaticResource PanelHeader}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="ActiveTakeoffTargetBar"
                            DockPanel.Dock="Top"
                            Visibility="Visible"
                            Height="38"
                            Background="{DynamicResource ControlActiveBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,2">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnActiveTakeoffRecord"
                                    DockPanel.Dock="Right"
                                    Content="Record"
                                    Click="BtnActiveTakeoffRecord_Click"
                                    Padding="6,2"
                                    Margin="6,0,0,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTip="Start or stop recording into the active takeoff item (Space)"/>
                            <Button x:Name="BtnActiveTakeoffMore"
                                    DockPanel.Dock="Right"
                                    Content="More"
                                    Click="BtnActiveTakeoffMore_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTip="More active target actions"/>
                            <Button x:Name="BtnActiveTakeoffProperties"
                                    DockPanel.Dock="Right"
                                    Content="Props"
                                    Click="BtnActiveTakeoffProperties_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Edit active takeoff item properties"/>
                            <Button x:Name="BtnActiveTakeoffFind"
                                    DockPanel.Dock="Right"
                                    Content="Find"
                                    Click="BtnActiveTakeoffFind_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Show active takeoff item in the tree"/>
                            <Button x:Name="BtnActiveTakeoffSheetNext"
                                    DockPanel.Dock="Right"
                                    Content="Sheet"
                                    Click="BtnActiveTakeoffSheetNext_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Choose a takeoff item measured on this sheet"/>
                            <Button x:Name="BtnActiveTakeoffNext"
                                    DockPanel.Dock="Right"
                                    Content="&gt;"
                                    Click="BtnActiveTakeoffNext_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Switch to next takeoff item"/>
                            <Button x:Name="BtnActiveTakeoffPrevious"
                                    DockPanel.Dock="Right"
                                    Content="&lt;"
                                    Click="BtnActiveTakeoffPrevious_Click"
                                    Padding="6,2"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="Switch to previous takeoff item"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ActiveTakeoffTargetGlyphHost"
                                        Width="18" Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtActiveTakeoffTarget"
                                               Text="No active takeoff"
                                               Foreground="{DynamicResource ControlActiveForegroundBrush}"
                                               FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtActiveTakeoffTargetMeta"
                                               Text=""
                                               Foreground="{DynamicResource ControlActiveForegroundBrush}"
                                               Opacity="0.86"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
