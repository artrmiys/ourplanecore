<UserControl x:Class="OurPlanCore.Controls.KeyboardShortcutsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ShortcutKey" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,1,7,1"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ShortcutSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <Border Margin="18"
            Padding="18,15,12,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            MaxWidth="1240"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="2,0,8,12" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Keyboard shortcuts"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ControlForegroundBrush}"/>
                    <TextBlock Text="Only currently reachable commands are listed; context is shown by section."
                               Margin="0,2,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Text="Esc to close  ·  F1 toggles"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" ItemWidth="280"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,12,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,13">
                                            <TextBlock Style="{StaticResource ShortcutSection}" Text="{Binding Title}"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource ShortcutKey}">
                                                                <TextBlock Text="{Binding Gesture}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource ControlForegroundBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="0,1,0,1">
                                                                <TextBlock Text="{Binding Action}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource ControlForegroundBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Note}"
                                                                           FontSize="9"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
