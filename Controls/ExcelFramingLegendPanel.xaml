<UserControl x:Class="OurPlanCore.Controls.ExcelFramingLegendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1,0,1,0">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Click="BtnClose_Click"
                            Width="20" Height="20" MinWidth="20"
                            Padding="0"
                            ToolTip="Hide the Excel legend panel">
                        <Path Data="{DynamicResource IconClose}"
                              Stretch="Uniform" Width="9" Height="9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                    <TextBlock Text="Excel framing legend"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource ControlForegroundBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="10,9,10,12">
                <TextBlock Text="Paste one legend record per line. Example: H5 - (2) 1 3/4 x 11 7/8 LVL. The text is stored with this job and is appended only after duplicate summing."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="LegendTextBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         MinHeight="260"
                         VerticalAlignment="Stretch"
                         SpellCheck.IsEnabled="False"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Save for job"
                            Click="BtnSave_Click"
                            Margin="0,0,6,0"
                            Padding="10,4"/>
                    <Button Content="Clear"
                            Click="BtnClear_Click"
                            Padding="10,4"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
