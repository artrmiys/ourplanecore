<UserControl x:Class="OurPlanCore.Controls.LiveInputRibbonSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource RibbonGroup}">
        <StackPanel Style="{StaticResource RibbonGroupBody}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LFT size" Style="{StaticResource RibbonRowLabel}"/>
                <Slider Grid.Column="1" x:Name="SizeSlider" Minimum="8" Maximum="24"
                        SmallChange="1" LargeChange="2" Width="76" Style="{StaticResource RibbonSlider}"
                        ValueChanged="SizeSlider_ValueChanged" PreviewMouseUp="Slider_Commit" KeyUp="Slider_Commit"
                        ToolTip="Live LFT and pitch label size in screen pixels"/>
                <TextBox Grid.Column="2" x:Name="SizeTextBox" Text="12"
                         AutomationProperties.AutomationId="TxtLiveInputLabelSizeValue"
                         Style="{StaticResource RibbonNumericValue}"
                         KeyDown="SizeTextBox_KeyDown" LostFocus="SizeTextBox_LostFocus"
                         ToolTip="Type live LFT and pitch label size from 8 to 24 px and press Enter"/>
                <TextBlock Grid.Column="3" Text="px" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </Grid>
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Opacity" Style="{StaticResource RibbonRowLabel}"/>
                <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="15" Maximum="100"
                        SmallChange="5" LargeChange="10" Width="76" Style="{StaticResource RibbonSlider}"
                        ValueChanged="OpacitySlider_ValueChanged" PreviewMouseUp="Slider_Commit" KeyUp="Slider_Commit"
                        ToolTip="Live LFT and pitch label opacity"/>
                <TextBox Grid.Column="2" x:Name="OpacityTextBox" Text="75"
                         AutomationProperties.AutomationId="TxtLiveInputLabelOpacityValue"
                         Style="{StaticResource RibbonNumericValue}"
                         KeyDown="OpacityTextBox_KeyDown" LostFocus="OpacityTextBox_LostFocus"
                         ToolTip="Type live LFT and pitch label opacity from 15 to 100 percent and press Enter"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </Grid>
        </StackPanel>
        <Border Style="{StaticResource RibbonGroupCap}">
            <TextBlock Text="LIVE LFT / PITCH" Style="{StaticResource RibbonGroupLabel}"/>
        </Border>
    </StackPanel>
</UserControl>
