<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Startup fallbacks — OurCore neutral-dark (default theme); ApplyTheme overrides at load -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush"  Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush"  Color="#707070"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#161616"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#262626"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#383838"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#A0A0A0"/>

    <!-- Takeoff tree row state brushes (theme-driven via ApplyTheme) -->
    <SolidColorBrush x:Key="RowOnPageBrush"        Color="#D6F5DE"/>
    <SolidColorBrush x:Key="RowActiveBrush"        Color="#FFECBE"/>
    <SolidColorBrush x:Key="RowMultiSelectBrush"   Color="#CDE2FF"/>
    <SolidColorBrush x:Key="RowDropOkBrush"        Color="#CCF5DA"/>
    <SolidColorBrush x:Key="RowDropBadBrush"       Color="#FFD6D6"/>
    <SolidColorBrush x:Key="RowFlagForegroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="RowActiveAccentBrush"   Color="#1F52A6"/>
    <SolidColorBrush x:Key="RowSelectionBrush"      Color="#BFD4EC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BFD4EC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111111"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#BFD4EC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111111"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#888888"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#202020"/>

    <!-- Slim scrollbar ControlTemplate (no arrow buttons) -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="2"
                            Background="{DynamicResource ScrollBarThumbBrush}"
                            Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageStyle" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="{DynamicResource ScrollBarTrackBrush}" Width="8" CornerRadius="2">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageStyle}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageStyle}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="HScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="{DynamicResource ScrollBarTrackBrush}" Height="8" CornerRadius="2">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageStyle}"
                                  Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageStyle}"
                                  Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width"    Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource VScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template" Value="{StaticResource HScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#262626"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#363636"/>
    <SolidColorBrush x:Key="ControlActiveBackgroundBrush" Color="#234764"/>
    <SolidColorBrush x:Key="ControlActiveForegroundBrush" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4EA1FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FB4FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3D8AE8"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <!-- OurCore sage brand signal — active sub-tab underline + applied badge -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#8FB89A"/>
    <SolidColorBrush x:Key="ToolbarBandBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ManagerHeaderBrush" Color="#282828"/>
    <SolidColorBrush x:Key="SubtleButtonBackgroundBrush" Color="#282828"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CommitBrush" Color="#4DCC8B"/>
    <SolidColorBrush x:Key="CommitHoverBrush" Color="#66D6A0"/>
    <SolidColorBrush x:Key="CommitPressedBrush" Color="#3CB478"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool button: highlighted when active -->
    <Style x:Key="ToolBtn" TargetType="Button">
        <Setter Property="Padding"   Value="8,3"/>
        <Setter Property="MinWidth"  Value="36"/>
        <Setter Property="Margin"    Value="2,0"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolBtnActive" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
        <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ManagerButton" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="66"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="ManagerPrimaryButton" TargetType="Button" BasedOn="{StaticResource ManagerButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ManagerCommitButton" TargetType="Button" BasedOn="{StaticResource ManagerButton}">
        <Setter Property="Background" Value="{DynamicResource CommitBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CommitBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CommitHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CommitHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CommitPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CommitPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ManagerSubtleButton" TargetType="Button" BasedOn="{StaticResource ManagerButton}">
        <Setter Property="Background" Value="{DynamicResource SubtleButtonBackgroundBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <ControlTemplate x:Key="ToolToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="ToggleChrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="2"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.55"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ManagerGroupLabel" TargetType="TextBlock">
        <Setter Property="Background" Value="{DynamicResource ManagerHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,7,4"/>
    </Style>

    <Style x:Key="ManagerToolbar" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="ManagerToolbarBand" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ToolbarBandBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="7,5,7,1"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ManagerSurface" TargetType="DockPanel">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ToolBtn}"/>
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource ToolBtn}"/>
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template" Value="{StaticResource ToolToggleButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template" Value="{StaticResource ToolToggleButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- RadioButton styled as a tool toggle (used for drawing tools group). -->
    <!-- Bottom-bar tool toggle: bordered chrome (Pan/Select/Count/Line/…). -->
    <Style x:Key="ToolRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlActiveForegroundBrush}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless ribbon tool toggle for the Annotation tab — clean look like
         TopCommandButton on the Page tab: transparent, hover/active fill only. -->
    <Style x:Key="ToolRadioFlat" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlActiveForegroundBrush}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Themed horizontal slider: thin track, accent-filled portion, round thumb. -->
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2"
                                Background="{TemplateBinding Background}"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Margin="0,0,-3,0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="14" Height="14" Background="Transparent">
                                                <Ellipse x:Name="ThumbEl"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         Stroke="{DynamicResource SurfaceBackgroundBrush}"
                                                         StrokeThickness="2"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbEl" Property="Fill" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbEl" Property="Fill" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>
    <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="1"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="2"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource ControlForegroundBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Background="{TemplateBinding Background}"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource ControlForegroundBrush}"
                                 Foreground="{TemplateBinding Foreground}"
                                 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 Margin="{TemplateBinding Padding}"
                                 Visibility="Hidden"
                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True"/>
                                <ScrollViewer Margin="1"
                                              Background="{DynamicResource SurfaceBackgroundBrush}"
                                              CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="MinHeight" Value="24"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <!-- Panel section header (Pages / Takeoffs / PDF Layers headers) -->
    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>
    <Style x:Key="PanelHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- GridView column headers (AI Inbox): clean theme hover/press instead of
         the washed-out default highlight in the dark theme. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background"   Value="{DynamicResource ManagerHeaderBrush}"/>
        <Setter Property="Foreground"   Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Padding"      Value="6,3"/>
        <Setter Property="FontSize"     Value="11"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="HdrBd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HdrBd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HdrBd" Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListView rows follow theme -->
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"    Value="0,1"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- List rows that select like the Pages/Takeoffs trees: a solid,
         focus-independent fill of RowSelectionBrush. The default ListView
         selection renders a washed-out near-white band in the dark theme, so
         Bookmarks and the AI Inbox use this template instead. -->
    <Style x:Key="TreeRowListItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListView control itself -->
    <Style TargetType="ListView">
        <Setter Property="Background"      Value="{DynamicResource SurfaceBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>


    <!-- Ribbon vocabulary (shared by MainWindow ribbon, PDF Output, dialogs). -->
    <Style x:Key="TopCommandButton" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <!-- Borderless ribbon command buttons: clean, hover-only background -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="TopCommandToggle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource ToolToggleButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlActiveBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlActiveForegroundBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TopCommandCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Ellipse x:Name="ring" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"
                                     Fill="{DynamicResource ControlBackgroundBrush}"/>
                            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TopCommandLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
    <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="RibbonGroupCap" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="RibbonRowLabel" TargetType="TextBlock" BasedOn="{StaticResource TopCommandLabel}">
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <ControlTemplate x:Key="RibbonSliderThumb" TargetType="Thumb">
        <Grid>
            <Ellipse x:Name="dot" Width="12" Height="12"
                     Fill="{DynamicResource AccentBrush}"
                     Stroke="{DynamicResource SurfaceBackgroundBrush}" StrokeThickness="2"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentPressedBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSliderFill" TargetType="RepeatButton">
        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                Background="{DynamicResource AccentBrush}"/>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSliderEmpty" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSliderTemplate" TargetType="Slider">
        <Grid VerticalAlignment="Center" Height="18">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource ControlHoverBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                  OverridesDefaultStyle="True" Template="{StaticResource RibbonSliderFill}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                  OverridesDefaultStyle="True" Template="{StaticResource RibbonSliderEmpty}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Width="12" Height="12" OverridesDefaultStyle="True"
                           Template="{StaticResource RibbonSliderThumb}"/>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="RibbonSlider" TargetType="Slider">
        <Setter Property="Width" Value="104"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="IsSnapToTickEnabled" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template" Value="{StaticResource RibbonSliderTemplate}"/>
    </Style>
    <Style x:Key="RibbonValue" TargetType="TextBox">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <Style x:Key="RibbonGroup" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="RibbonGroupBody" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="RibbonGroupSep" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Margin" Value="6,1,6,1"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>
